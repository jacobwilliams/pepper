def writla(numlin, array, unit):
    """Write an array of text lines to a Fortran logical unit.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/writla.html
    
    :param numlin: Number of lines to be written to the file.
    :param array: Array containing the lines to be written.
    :param unit: Fortran unit number to use for output."""
    return _context().writla(numlin, array, unit)

def writln(line, unit):
    """Write a single line of text to the Fortran logical unit UNIT.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/writln.html
    
    :param line: The line which is to be written to UNIT.
    :param unit: The Fortran unit number to use for output."""
    return _context().writln(line, unit)

def wrpool(unit):
    """Write to a specified unit a set of 'keyword = value' assignments for all currently defined kernel variables. The assignments constitute a text kernel from which the current state of the kernel pool can be restored.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/wrpool.html
    
    :param unit: Logical unit to which the variables in the pool will be"""
    return _context().wrpool(unit)

def xf2eul(xform, axisa, axisb, axisc):
    """Convert a state transformation matrix to Euler angles and their derivatives, given a specified set of axes.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/xf2eul.html
    
    :param xform: A state transformation matrix.
    :param axisa: Axis A of the Euler angle factorization.
    :param axisb: Axis B of the Euler angle factorization.
    :param axisc: Axis C of the Euler angle factorization.
    :return: An array of Euler angles and their derivatives.; Indicates if EULANG is a unique representation."""
    return _context().xf2eul(xform, axisa, axisb, axisc)

def xfmsta(input_state, input_coord_sys, output_coord_sys, body):
    """Transform a state between coordinate systems.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/xfmsta.html
    
    :param input_state: Input state.
    :param input_coord_sys: Current (input) coordinate system.
    :param output_coord_sys: Desired (output) coordinate system.
    :param body: Name or NAIF ID of body with which coordinates are associated (if applicable).
    :return: Converted output state."""
    return _context().xfmsta(input_state, input_coord_sys, output_coord_sys, body)

def xposbl(bmat, nrow, ncol, bsize):
    """Transpose the square blocks within a matrix.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/xposbl.html
    
    :param bmat: a matrix composed of square block
    :param nrow: the number of rows in the matrix BMAT
    :param ncol: the number of columns in the matrix BMAT
    :param bsize: the size of the square blocks in BMAT
    :return: the result of transposing the blocks of"""
    return _context().xposbl(bmat, nrow, ncol, bsize)

def xxsgp4e(t):
    """This procedure is the SGP4 prediction model from Space Command. This is an updated and combined version of SGP4 and SDP4 originally published separately in Spacetrack report #3 [1]. This version follows the methodology from the 2006 AIAA Vallado paper [4] describing the history and development of the code.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/xxsgp4e.html
    
    :param t: Time to evaluate state in minutes from epoch.
    :return: Evaluated state."""
    return _context().xxsgp4e(t)

def xxsgp4i(geophs, elems, opmode):
    """This subroutine initializes variables for SGP4.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/xxsgp4i.html
    
    :param geophs: Geophysical constants.
    :param elems: Two-line element data.
    :param opmode: Flag to indicate operation mode for GMST."""
    return _context().xxsgp4i(geophs, elems, opmode)

def boddef(name, code):
    """Define a body name/ID code pair for later translation via `bodn2c` or `bodc2n`.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/boddef.html
    
    :param name: Common name of some body.
    :param code: Integer code for that body."""
    return _instance().boddef(name, code)

def cklpf(filename):
