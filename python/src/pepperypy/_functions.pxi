    return _context().spkw15(handle, body, center, inframe, first, last, segid, epoch, tp, pa, p, ecc, j2flg, pv, gm, j2, radius)

def spkw17(handle, body, center, inframe, first, last, segid, epoch, eqel, rapol, decpol):
    """Write an SPK segment of type 17 given a type 17 data record.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/spkw17.html
    
