def wncard(window):
    """Return the cardinality (number of intervals) of a double precision window.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/wncard.html
    
    :param window: Input window.
    :return: the result"""
    return _context().wncard(window)

def wncomd(left, right, window, result=None):
    """Determine the complement of a double precision window with respect to the interval [LEFT,RIGHT].
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/wncomd.html
    
    :param left: Left, right endpoints of complement interval.
    :param right: Left, right endpoints of complement interval.
    :param window: Input window.
    :param result: Complement of WINDOW with respect to
    :return: Complement of WINDOW with respect to"""
    return _context().wncomd(left, right, window, result)

def wncond(left, right, window=None):
    """Contract each of the intervals of a double precision window.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/wncond.html
    
    :param left: Amount added to each left endpoint.
    :param right: Amount subtracted from each right endpoint.
    :param window: Window to be contracted.
    :return: Window to be contracted."""
    return _context().wncond(left, right, window)

def wndifd(a, b, c=None):
    """Place the difference of two double precision windows into a third window.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/wndifd.html
    
    :param a: Input windows.
    :param b: Input windows.
    :param c: Difference of A and B.
    :return: Difference of A and B."""
    return _context().wndifd(a, b, c)

def wnelmd(point, window):
    """Determine whether a point is an element of a double precision window.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/wnelmd.html
    
    :param point: Input point.
    :param window: Input window.
    :return: the result"""
    return _context().wnelmd(point, window)

def wnexpd(left, right, window=None):
    """Expand each of the intervals of a double precision window.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/wnexpd.html
    
    :param left: Amount subtracted from each left endpoint.
    :param right: Amount added to each right endpoint.
    :param window: Window to be expanded.
    :return: Window to be expanded."""
    return _context().wnexpd(left, right, window)

def wnextd(side, window=None):
    """Extract the left or right endpoints from a double precision window.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/wnextd.html
    
    :param side: Extract left ('L') or right ('R') endpoints.
    :param window: Window to be extracted.
    :return: Window to be extracted."""
    return _context().wnextd(side, window)

def wnfetd(window, n):
    """Fetch a particular interval from a double precision window.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/wnfetd.html
    
    :param window: Input window.
    :param n: Index of interval to be fetched.
    :return: Left, right endpoints of the Nth interval.; Left, right endpoints of the Nth interval."""
    return _context().wnfetd(window, n)

def wnfild(small, window=None):
    """Fill small gaps between adjacent intervals of a double precision window.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/wnfild.html
    
    :param small: Limiting measure of small gaps.
    :param window: Window to be filled.
    :return: Window to be filled."""
    return _context().wnfild(small, window)

def wnfltd(small, window=None):
    """Filter (remove) small intervals from a double precision window.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/wnfltd.html
    
    :param small: Limiting measure of small intervals.
    :param window: Window to be filtered.
    :return: Window to be filtered."""
    return _context().wnfltd(small, window)

def wnincd(left, right, window):
    """Determine whether an interval is included in a double precision window.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/wnincd.html
    
    :param left: Input interval.
    :param right: Input interval.
    :param window: Input window.
    :return: the result"""
    return _context().wnincd(left, right, window)

def wninsd(left, right, window=None):
    """Insert an interval into a double precision window.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/wninsd.html
    
    :param left: Left, right endpoints of new interval.
    :param right: Left, right endpoints of new interval.
    :param window: Input, output window.
    :return: Input, output window."""
    return _context().wninsd(left, right, window)

def wnintd(a, b, c=None):
    """Place the intersection of two double precision windows into a third window.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/wnintd.html
    
    :param a: Input windows.
    :param b: Input windows.
    :param c: Intersection of A and B.
    :return: Intersection of A and B."""
    return _context().wnintd(a, b, c)

def wnreld(a, op, b):
    """Compare two double precision windows.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/wnreld.html
    
    :param a: First window.
    :param op: Comparison operator.
    :param b: Second window.
    :return: the result"""
    return _context().wnreld(a, op, b)

def wnsumd(window):
    """Summarize the contents of a double precision window.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/wnsumd.html
    
    :param window: Window to be summarized.
    :return: Total measure of intervals in WINDOW.; Average measure.; Standard deviation.; Locations of shortest, longest intervals.; Locations of shortest, longest intervals."""
    return _context().wnsumd(window)

def wnunid(a, b, c=None):
    """Place the union of two double precision windows into a third window.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/wnunid.html
    
    :param a: Input windows.
    :param b: Input windows.
    :param c: Union of A and B.
    :return: Union of A and B."""
    return _context().wnunid(a, b, c)

def wnvald(insize, n, window=None):
    """Form a valid double precision window from the contents of a window array.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/wnvald.html
    
    :param insize: Size of window.
    :param n: Original number of endpoints.
    :param window: Input, output window.
    :return: Input, output window."""
    return _context().wnvald(insize, n, window)

def wrencc(unit, n, data):
    """Encode and write characters to a text file.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/wrencc.html
    
    :param unit: Fortran unit number of output text file.
    :param n: Number of characters to encode and write.
    :param data: List of characters to encode and write."""
    return _context().wrencc(unit, n, data)

def wrencd(unit, n, data):
    """Encode and write d.p. numbers to a text file.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/wrencd.html
    
    :param unit: Fortran unit number of output text file.
    :param n: Number of d.p. numbers to encode and write.
    :param data: List of d.p. numbers to encode and write."""
    return _context().wrencd(unit, n, data)

def wrenci(unit, n, data):
    """Encode and write integers to a text file.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/wrenci.html
    
    :param unit: Fortran unit number of output text file.
    :param n: Number of integers to encode and write.
    :param data: List of integers to be encoded and written."""
