def cvpool(agent):
    """Indicate whether or not any watched kernel variables that have a specified agent on their notification list have been updated.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/cvpool.html
    
