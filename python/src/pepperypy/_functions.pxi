def gf_ray_in_fov(inst, raydir, rframe, abcorr, obsrvr, step, cnfine):
    """A GF search on a ray in an instrument field of view (PEPPER; `gfrfov` with the confinement and result windows as arrays, and without workspace).
    
    :param inst: Name of the instrument.
    :param raydir: Ray's direction vector.
    :param rframe: Reference frame of ray's direction vector.
