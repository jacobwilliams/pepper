    return _instance().cklpf(filename)

def ckupf(handle):
    """Unload a CK pointing file so that it will no longer be searched by the readers.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/ckupf.html
    
    :param handle: Handle of CK file to be unloaded"""
    return _instance().ckupf(handle)

def clpool():
    """Remove all kernel variables from the kernel pool. Watches on kernel variables are retained.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/clpool.html
    """
    return _instance().clpool()

def dvpool(name):
    """Delete a variable from the kernel pool.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dvpool.html
    
