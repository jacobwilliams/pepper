    return _context().ckw03(handle, begtim, endtim, inst, ref, avflag, segid, nrec, sclkdp, quats, avvs, nints, starts)

def ckw04a(handle, npkts, pktsiz, pktdat, sclkdp):
    """Add data to a type 4 CK segment currently being written to the file associated with HANDLE. See also `ckw04b` and `ckw04e`.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/ckw04a.html
    
    :param handle: The handle of an DAF file opened for writing.
    :param npkts: Number of data packets to write to a segment.
    :param pktsiz: The numbers of values in the data packets (PEPPER: changed in place)
    :param pktdat: The data packets. (PEPPER: packed in place)
    :param sclkdp: The SCLK times associated with the data packets.
    :return: The numbers of values in the data packets (PEPPER: changed in place); The data packets. (PEPPER: packed in place)"""
    return _context().ckw04a(handle, npkts, pktsiz, pktdat, sclkdp)

def ckw04b(handle, begtim, inst, ref, avflag, segid):
    """Begin a type CK04 segment in the DAF file associated with HANDLE. See also `ckw04a` and `ckw04e`.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/ckw04b.html
    
    :param handle: The handle of an DAF file open for writing.
    :param begtim: The segment coverage start encoded SCLK time
    :param inst: The NAIF ID code for the SC or instrument.
    :param ref: The reference frame for this segment.
    :param avflag: The angular rates flag.
    :param segid: The string to use for segment identifier."""
    return _context().ckw04b(handle, begtim, inst, ref, avflag, segid)

def ckw04e(handle, endtim):
    """End the type 04 CK segment currently being written to the DAF file associated with HANDLE. See also `ckw04b` and `ckw04e`.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/ckw04e.html
    
    :param handle: The handle of an CK file open for writing.
    :param endtim: The segment coverage end encoded SCLK time."""
    return _context().ckw04e(handle, endtim)

def ckw05(handle, subtype, degree, begtim, endtim, inst, ref, avflag, segid, sclkdp, packts, rate, nints, starts):
    """Write a type 5 segment to a CK file.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/ckw05.html
    
    :param handle: Handle of an CK file open for writing.
    :param subtype: CK type 5 subtype code.
    :param degree: Degree of interpolating polynomials.
    :param begtim: Start time of interval covered by segment.
    :param endtim: End time of interval covered by segment.
    :param inst: NAIF code for a s/c instrument or structure.
    :param ref: Reference frame name.
    :param avflag: Flag indicating if the segment will contain angular velocity.
    :param segid: Segment identifier.
    :param sclkdp: Encoded SCLK times.
    :param packts: Array of packets.
    :param rate: Nominal SCLK rate in seconds per tick.
    :param nints: Number of intervals.
    :param starts: Encoded SCLK interval start times."""
    return _context().ckw05(handle, subtype, degree, begtim, endtim, inst, ref, avflag, segid, sclkdp, packts, rate, nints, starts)

def ckw06(handle, inst, ref, avflag, first, last, segid, nmini, npkts, subtps, degres, packts, rates, sclkdp, ivlbds, sellst):
    """Write a type 6 segment to a CK file.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/ckw06.html
    
    :param handle: Handle of a CK file open for writing.
    :param inst: NAIF instrument ID code.
    :param ref: Reference frame name.
    :param avflag: Flag indicating if the segment will contain angular velocity.
    :param first: Start time of interval covered by segment.
    :param last: End time of interval covered by segment.
    :param segid: Segment identifier.
    :param nmini: Number of mini-segments.
    :param npkts: Array of packet counts of mini-segments.
    :param subtps: Array of segment subtypes of mini-segments.
    :param degres: Array of polynomial degrees of mini-segments.
    :param packts: Array of data packets of mini-segments.
    :param rates: Nominal SCLK rates in seconds per tick.
    :param sclkdp: Array of epochs of mini-segments.
    :param ivlbds: Mini-segment interval bounds.
    :param sellst: Interval selection flag."""
    return _context().ckw06(handle, inst, ref, avflag, first, last, segid, nmini, npkts, subtps, degres, packts, rates, sclkdp, ivlbds, sellst)

def cltext(fname):
    """Close a text file currently opened by `rdtext`.
    
