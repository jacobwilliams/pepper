def spkw05(handle, body, center, inframe, first, last, segid, gm, n, states, epochs):
    """Write an SPK segment of type 5 given a time-ordered set of discrete states and epochs, and the gravitational parameter of a central body.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/spkw05.html
    
    :param handle: Handle of an SPK file open for writing.
    :param body: Body code for ephemeris object.
