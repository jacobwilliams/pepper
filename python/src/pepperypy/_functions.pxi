def spkw19(handle, body, center, frame, first, last, segid, nintvl, npkts, subtps, degres, packts, epochs, ivlbds, sellst):
    """Write a type 19 segment to an SPK file.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/spkw19.html
    
    :param handle: Handle of an SPK file open for writing.
