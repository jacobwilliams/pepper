def gf_position(target, frame, abcorr, obsrvr, crdsys, coord, relate, refval, adjust, step, cnfine):
    """A GF search on a coordinate of a position vector (PEPPER; `gfposc` with the confinement and result windows as arrays, and without workspace).
    
