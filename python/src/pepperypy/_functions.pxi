def ekuef(handle):
    """Unload an EK file, making its contents inaccessible to the EK reader routines, and clearing space in order to allow other EK files to be loaded.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/ekuef.html
    
    :param handle: Handle of EK file."""
    return _instance().ekuef(handle)

def ldpool(filename):
    """Load the variables contained in a NAIF ASCII kernel file into the kernel pool. Lines have at most 132 characters; a longer line is cut without an error (see Restrictions).
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/ldpool.html
    
    :param filename: Name of the text kernel file."""
    return _instance().ldpool(filename)

def pcklof(filename):
    """Load a binary PCK file for use by the readers. Return the handle of the loaded file which is used by other PCK routines to refer to the file.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/pcklof.html
    
