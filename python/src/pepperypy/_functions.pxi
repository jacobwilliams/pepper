    return _context().spkw21(handle, body, center, frame, first, last, segid, n, dlsize, dlines, epochs)

def srfc2s(code, bodyid, srflen=None):
    """Translate a surface ID code, together with a body ID code, to the corresponding surface name. If no such name exists, return a string representation of the surface ID code.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/srfc2s.html
    
    :param code: Integer surface ID code to translate to a string.
    :param bodyid: ID code of body associated with surface.
    :param srflen: (SpiceyPy compatibility; ignored)
    :return: String corresponding to surface ID code.
        (found: NotFoundError if not found, or the flag returned last with no_found_check)"""
    return _context().srfc2s(code, bodyid, srflen)

def srfcss(code, bodstr, srflen=None):
    """Translate a surface ID code, together with a body string, to the corresponding surface name. If no such surface name exists, return a string representation of the surface ID code.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/srfcss.html
    
    :param code: Integer surface ID code to translate to a string.
    :param bodstr: Name or ID of body associated with surface.
    :param srflen: (SpiceyPy compatibility; ignored)
    :return: String corresponding to surface ID code.
        (found: NotFoundError if not found, or the flag returned last with no_found_check)"""
    return _context().srfcss(code, bodstr, srflen)

def srfnrm(method, target, et, fixref, srfpts):
    """Map array of surface points on a specified target body to the corresponding unit length outward surface normal vectors.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/srfnrm.html
    
    :param method: Computation method.
    :param target: Name of target body.
    :param et: Epoch in TDB seconds past J2000 TDB.
    :param fixref: Body-fixed, body-centered target body frame.
    :param srfpts: Array of surface points.
    :return: Array of outward, unit length normal vectors."""
    return _context().srfnrm(method, target, et, fixref, srfpts)

def srfrec(body, longitude, latitude):
    """Convert planetocentric latitude and longitude of a surface point on a specified body to rectangular coordinates.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/srfrec.html
    
    :param body: NAIF integer code of an extended body.
    :param longitude: Longitude of point in radians.
    :param latitude: Latitude of point in radians.
    :return: Rectangular coordinates of the point."""
    return _context().srfrec(body, longitude, latitude)

def srfs2c(srfstr, bodstr):
    """Translate a surface string, together with a body string, to the corresponding surface ID code. The input strings may contain names or integer ID codes.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/srfs2c.html
    
    :param srfstr: Surface name or ID string.
    :param bodstr: Body name or ID string.
    :return: Integer surface ID code.
        (found: NotFoundError if not found, or the flag returned last with no_found_check)"""
    return _context().srfs2c(srfstr, bodstr)

def srfscc(srfstr, bodyid):
    """Translate a surface string, together with a body ID code, to the corresponding surface ID code. The input surface string may contain a name or an integer ID code.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/srfscc.html
    
    :param srfstr: Surface name or ID string.
    :param bodyid: Body ID code.
    :return: Integer surface ID code.
        (found: NotFoundError if not found, or the flag returned last with no_found_check)"""
    return _context().srfscc(srfstr, bodyid)

def srfxpt(method, target, et, abcorr, obsrvr, dref, dvec):
    """**Deprecated:** This routine has been superseded by the SPICELIB routine `sincpt`. This routine is supported for purposes of backward compatibility only.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/srfxpt.html
    
