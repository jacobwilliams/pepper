    :return: Shifted string."""
    cdef int _c_nshift = nshift
    cdef char _c_out[1024]
    cdef int _st = 0
    cdef bytes _b_in = _b(in_)
    cdef bytes _b_fillc = _b(fillc)
    cdef const char *_c_in = _b_in
    cdef const char *_c_fillc = _b_fillc
    _c_out[0] = 0
    pepper_shiftl(_c_in, _c_nshift, _c_fillc, 1024, _c_out)
    return _s(_c_out)

