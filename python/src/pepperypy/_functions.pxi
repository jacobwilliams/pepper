def b1900():
    """Besselian date 1900.0 (a constant)."""
    return 2415020.31352

def b1950():
    """Besselian date 1950.0 (a constant)."""
    return 2433282.42345905

def clight():
    """speed of light in vacuum (km/s) (a constant)."""
    return 299792.458

def dpmax():
    """largest real (a constant)."""
    return 1.79769313486231e+308

def dpmin():
    """smallest (most negative) (a constant)."""
    return -1.79769313486231e+308

def dpr():
    """degrees per radian (a constant)."""
    return 57.29577951308232

def halfpi():
    """pi / 2 (a constant)."""
    return 1.5707963267948966

def j1900():
    """Julian date 1899 DEC 31 12:00:00 (a constant)."""
    return 2415020.0

def j1950():
    """Julian date 1950 JAN 01 00:00:00 (a constant)."""
    return 2433282.5

def j2000():
    """Julian date 2000 JAN 01 12:00:00 (a constant)."""
    return 2451545.0

def j2100():
    """Julian date 2100 JAN 01 12:00:00 (a constant)."""
    return 2488070.0

def jyear():
    """seconds per Julian year (a constant)."""
    return 31557600.0

def pi():
    """pi (a constant)."""
    return 3.141592653589793

def rpd():
    """radians per degree (a constant)."""
    return 0.017453292519943295

def spd():
    """seconds per day (a constant)."""
    return 86400.0

def twopi():
    """2 pi (a constant)."""
    return 6.283185307179586

def tyear():
    """seconds per tropical year (a constant)."""
    return 31556925.9747
