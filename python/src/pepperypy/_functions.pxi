    return _context().stcg01(index)

def stcl01(catfnm):
    """Load SPICE type 1 star catalog and return the catalog's table name.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/stcl01.html
    
