    :param initfr: Fractional part of begin time of first record."""
    return _context().spkw20(handle, body, center, inframe, first, last, segid, intlen, n, polydg, cdata, dscale, tscale, initjd, initfr)

def spkw21(handle, body, center, frame, first, last, segid, n, dlsize, dlines, epochs):
