def gfbail():
    """Serve as a placeholder for an interrupt detection function.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/gfbail.html
    
    :return: the result"""
    return _context().gfbail()

def gffove(inst, tshape, raydir, target, tframe, abcorr, obsrvr, tol, udstep, udrefn, rpt, udrepi, udrepu, udrepf, bail, udbail, cnfine, result=None):
    """Determine time intervals when a specified target body or ray intersects the space bounded by the field-of-view (FOV) of a specified instrument. Report progress and handle interrupts if so commanded.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/gffove.html
    
    :param inst: Name of the instrument.
    :param tshape: Type of shape model used for target body.
    :param raydir: Ray's direction vector.
    :param target: Name of the target body.
    :param tframe: Body-fixed, body-centered frame for target body.
    :param abcorr: Aberration correction flag.
    :param obsrvr: Name of the observing body.
    :param tol: Convergence tolerance in seconds.
    :param udstep: Name of routine that returns a time step.
    :param udrefn: Name of the routine that computes a refined time.
    :param rpt: Progress report flag.
    :param udrepi: Function that initializes progress reporting.
    :param udrepu: Function that updates the progress report.
    :param udrepf: Function that finalizes progress reporting.
    :param bail: Logical indicating program interrupt monitoring.
    :param udbail: Name of a routine that signals a program interrupt.
    :param cnfine: SPICE window to which the search is restricted.
    :param result: SPICE window containing results.
    :return: SPICE window containing results."""
    return _context().gffove(inst, tshape, raydir, target, tframe, abcorr, obsrvr, tol, udstep, udrefn, rpt, udrepi, udrepu, udrepf, bail, udbail, cnfine, result)

def gfocce(occtyp, front, fshape, fframe, back, bshape, bframe, abcorr, obsrvr, tol, udstep, udrefn, rpt, udrepi, udrepu, udrepf, bail, udbail, cnfine, result=None):
    """Determine time intervals when an observer sees one target occulted by another. Report progress and handle interrupts if so commanded.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/gfocce.html
    
    :param occtyp: Type of occultation.
    :param front: Name of body occulting the other.
    :param fshape: Type of shape model used for front body.
    :param fframe: Body-fixed, body-centered frame for front body.
    :param back: Name of body occulted by the other.
    :param bshape: Type of shape model used for back body.
    :param bframe: Body-fixed, body-centered frame for back body.
    :param abcorr: Aberration correction flag.
    :param obsrvr: Name of the observing body.
    :param tol: Convergence tolerance in seconds.
    :param udstep: Name of the routine that returns a time step.
    :param udrefn: Name of the routine that computes a refined time.
    :param rpt: Progress report flag.
    :param udrepi: Function that initializes progress reporting.
    :param udrepu: Function that updates the progress report.
    :param udrepf: Function that finalizes progress reporting.
    :param bail: Logical indicating program interrupt monitoring.
    :param udbail: Name of a routine that signals a program interrupt.
    :param cnfine: SPICE window to which the search is restricted.
    :param result: SPICE window containing results.
    :return: SPICE window containing results."""
    return _context().gfocce(occtyp, front, fshape, fframe, back, bshape, bframe, abcorr, obsrvr, tol, udstep, udrefn, rpt, udrepi, udrepu, udrepf, bail, udbail, cnfine, result)

def gfoclt(occtyp, front, fshape, fframe, back, bshape, bframe, abcorr, obsrvr, step, cnfine, result=None):
    """Determine time intervals when an observer sees one target body occulted by, or in transit across, another.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/gfoclt.html
    
    :param occtyp: Type of occultation.
    :param front: Name of body occulting the other.
    :param fshape: Type of shape model used for front body.
    :param fframe: Body-fixed, body-centered frame for front body.
    :param back: Name of body occulted by the other.
    :param bshape: Type of shape model used for back body.
    :param bframe: Body-fixed, body-centered frame for back body.
    :param abcorr: Aberration correction flag.
    :param obsrvr: Name of the observing body.
    :param step: Step size in seconds for finding occultation events.
    :param cnfine: SPICE window to which the search is restricted.
    :param result: SPICE window containing results.
    :return: SPICE window containing results."""
    return _context().gfoclt(occtyp, front, fshape, fframe, back, bshape, bframe, abcorr, obsrvr, step, cnfine, result)

def gfrefn(t1, t2, s1, s2):
    """Estimate, using a bisection method, the next abscissa value at which a state change occurs. This is the default GF refinement method.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/gfrefn.html
    
    :param t1: One of two values bracketing a state change.
    :param t2: The other value that brackets a state change.
    :param s1: State at T1.
    :param s2: State at T2.
    :return: New value at which to check for transition."""
    return _context().gfrefn(t1, t2, s1, s2)

def gfrepf():
    """Finish a progress report.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/gfrepf.html
    """
    return _context().gfrepf()

def gfrepi(window, begmss, endmss):
    """Initialize a search progress report.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/gfrepi.html
    
    :param window: A window over which a job is to be performed.
    :param begmss: Beginning of the text portion of output message.
    :param endmss: End of the text portion of output message."""
    return _context().gfrepi(window, begmss, endmss)

def gfrepu(ivbeg, ivend, time):
    """Tell the progress reporting system how far a search has progressed.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/gfrepu.html
    
    :param ivbeg: Start time of work interval.
    :param ivend: End time of work interval.
    :param time: Current time being examined in the search process"""
    return _context().gfrepu(ivbeg, ivend, time)

def gfrfov(inst, raydir, rframe, abcorr, obsrvr, step, cnfine, result=None):
    """Determine time intervals when a specified ray intersects the space bounded by the field-of-view (FOV) of a specified instrument.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/gfrfov.html
    
    :param inst: Name of the instrument.
    :param raydir: Ray's direction vector.
    :param rframe: Reference frame of ray's direction vector.
    :param abcorr: Aberration correction flag.
    :param obsrvr: Name of the observing body.
    :param step: Step size in seconds for finding FOV events.
    :param cnfine: SPICE window to which the search is restricted.
    :param result: SPICE window containing results.
    :return: SPICE window containing results."""
    return _context().gfrfov(inst, raydir, rframe, abcorr, obsrvr, step, cnfine, result)

def gfsstp(step):
    """Set the step size to be returned by `gfstep`.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/gfsstp.html
    
    :param step: Time step to take."""
    return _context().gfsstp(step)

def gfstep(time):
    """Return the time step set by the most recent call to `gfsstp`.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/gfstep.html
    
    :param time: Ignored ET value.
    :return: Time step to take."""
    return _context().gfstep(time)

def gfstol(value):
    """Override the default GF convergence value used in the high level GF routines.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/gfstol.html
    
    :param value: Double precision value returned or to store."""
    return _context().gfstol(value)

def gftfov(inst, target, tshape, tframe, abcorr, obsrvr, step, cnfine, result=None):
    """Determine time intervals when a specified ephemeris object intersects the space bounded by the field-of-view (FOV) of a specified instrument.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/gftfov.html
    
    :param inst: Name of the instrument.
    :param target: Name of the target body.
    :param tshape: Type of shape model used for target body.
    :param tframe: Body-fixed, body-centered frame for target body.
    :param abcorr: Aberration correction flag.
    :param obsrvr: Name of the observing body.
    :param step: Step size in seconds for finding FOV events.
    :param cnfine: SPICE window to which the search is restricted.
    :param result: SPICE window containing results.
    :return: SPICE window containing results."""
    return _context().gftfov(inst, target, tshape, tframe, abcorr, obsrvr, step, cnfine, result)

def gr2jul(year, month, day):
    """Convert Year Month and Day on the  Gregorian Calendar to the Julian Calendar
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/gr2jul.html
    
    :param year: Year  of Gregorian Calendar/Julian Calendar
    :param month: Month of Gregorian Calendar/Julian Calendar
    :param day: Day of Month in Gregorian Calendar/Julian Calendar
    :return: Year  of Gregorian Calendar/Julian Calendar; Month of Gregorian Calendar/Julian Calendar; Day of Month in Gregorian Calendar/Julian Calendar; Day of Year in Julian Calendar"""
    return _context().gr2jul(year, month, day)

def hrmesp(first, step, yvals, x):
    """Evaluate, at a specified point, a Hermite interpolating polynomial for a specified set of equally spaced abscissa values and corresponding pairs of function and function derivative values.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/hrmesp.html
    
    :param first: First abscissa value.
    :param step: Step size.
    :param yvals: Ordinate and derivative values.
    :param x: Point at which to interpolate the polynomial.
    :return: Interpolated function value at X.; Interpolated function's derivative at X."""
    return _context().hrmesp(first, step, yvals, x)

def hrmint(xvals, yvals, x):
    """Evaluate a Hermite interpolating polynomial at a specified abscissa value.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/hrmint.html
    
    :param xvals: Abscissa values.
    :param yvals: Ordinate and derivative values.
    :param x: Point at which to interpolate the polynomial.
    :return: Interpolated function value at X.; Interpolated function's derivative at X."""
    return _context().hrmint(xvals, yvals, x)

def hx2dp(string):
    """Convert a string representing a double precision number in a base 16 'scientific notation' into its equivalent double precision number.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/hx2dp.html
    
    :param string: Hex form string to convert to double precision.
    :return: Double precision value to be returned.; A logical flag which is .TRUE. on error.; A descriptive error message."""
    return _context().hx2dp(string)

def hx2int(string):
    """Convert a signed hexadecimal string representation of an integer to its equivalent integer.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/hx2int.html
    
    :param string: Hexadecimal string to be converted to an integer.
    :return: Integer value to be returned.; A logical flag which is .TRUE. on error.; A descriptive error message."""
    return _context().hx2int(string)

def hyptof(ma, ecc):
    """Solve the time of flight equation MA = e sinh(F) - F for the hyperbolic eccentric anomaly F, given the mean anomaly, MA, and the eccentricity, e.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/hyptof.html
    
    :param ma: Mean anomaly at epoch.
    :param ecc: Eccentricity.
    :return: Hyperbolic eccentric anomaly."""
    return _context().hyptof(ma, ecc)

def idw2at(idword):
    """Extract the architecture and type of a SPICE binary kernel file from a file ID word.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/idw2at.html
    
    :param idword: The IDWORD to be examined.
    :return: The file architecture DAS or DAF.; The type of the file."""
    return _context().idw2at(idword)

def illum(target, et, abcorr, obsrvr, spoint):
    """**Deprecated:** This routine has been superseded by the SPICELIB routine `ilumin`. This routine is supported for purposes of backward compatibility only.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/illum.html
    
    :param target: Name of target body.
    :param et: Epoch in ephemeris seconds past J2000.
    :param abcorr: Desired aberration correction.
    :param obsrvr: Name of observing body.
    :param spoint: Body-fixed coordinates of a target surface point.
    :return: Phase angle at the surface point.; Solar incidence angle at the surface point.; Emission angle at the surface point."""
    return _context().illum(target, et, abcorr, obsrvr, spoint)

def illumf(method, target, ilusrc, et, fixref, abcorr, obsrvr, spoint):
    """Compute the illumination angles---phase, incidence, and emission---at a specified point on a target body. Return logical flags indicating whether the surface point is visible from the observer's position and whether the surface point is illuminated.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/illumf.html
    
    :param method: Computation method.
    :param target: Name of target body.
    :param ilusrc: Name of illumination source.
    :param et: Epoch in ephemeris seconds past J2000 TDB.
    :param fixref: Body-fixed, body-centered target body frame.
    :param abcorr: Desired aberration correction.
    :param obsrvr: Name of observing body.
    :param spoint: Body-fixed coordinates of a target surface point.
    :return: Target surface point epoch.; Vector from observer to target surface point.; Phase angle at the surface point.; Source incidence angle at the surface point.; Emission angle at the surface point.; Visibility flag (.TRUE. = visible).; Illumination flag (.TRUE. = illuminated)."""
    return _context().illumf(method, target, ilusrc, et, fixref, abcorr, obsrvr, spoint)

def illumg(method, target, ilusrc, et, fixref, abcorr, obsrvr, spoint):
    """Find the illumination angles (phase, incidence, and emission) at a specified surface point of a target body.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/illumg.html
    
    :param method: Computation method.
    :param target: Name of target body.
    :param ilusrc: Name of illumination source.
    :param et: Epoch in ephemeris seconds past J2000 TDB.
    :param fixref: Body-fixed, body-centered target body frame.
    :param abcorr: Desired aberration correction.
    :param obsrvr: Name of observing body.
    :param spoint: Body-fixed coordinates of a target surface point.
    :return: Target surface point epoch.; Vector from observer to target surface point.; Phase angle at the surface point.; Source incidence angle at the surface point.; Emission angle at the surface point."""
    return _context().illumg(method, target, ilusrc, et, fixref, abcorr, obsrvr, spoint)

def ilumin(method, target, et, fixref, abcorr, obsrvr, spoint):
    """Find the illumination angles (phase, solar incidence, and emission) at a specified surface point of a target body.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/ilumin.html
    
    :param method: Computation method.
    :param target: Name of target body.
    :param et: Epoch in ephemeris seconds past J2000 TDB.
    :param fixref: Body-fixed, body-centered target body frame.
    :param abcorr: Desired aberration correction.
    :param obsrvr: Name of observing body.
    :param spoint: Body-fixed coordinates of a target surface point.
    :return: Target surface point epoch.; Vector from observer to target surface point.; Phase angle at the surface point.; Solar incidence angle at the surface point.; Emission angle at the surface point."""
    return _context().ilumin(method, target, et, fixref, abcorr, obsrvr, spoint)

def incnsg(apex, axis, angle, endpt1, endpt2):
    """Compute the points of intersection of a specified nappe of a cone and a line segment.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/incnsg.html
    
    :param apex: Apex of cone.
    :param axis: Axis of cone.
    :param angle: Angle of cone.
    :param endpt1: Endpoints of line segment.
    :param endpt2: Endpoints of line segment.
    :return: Number of intersection points.; First intersection point, if it exists.; Second intersection point, if it exists."""
    return _context().incnsg(apex, axis, angle, endpt1, endpt2)

def inedpl(a, b, c, plane):
    """Find the intersection of a triaxial ellipsoid and a plane.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/inedpl.html
    
    :param a: Length of ellipsoid semi-axis lying on the x-axis.
    :param b: Length of ellipsoid semi-axis lying on the y-axis.
    :param c: Length of ellipsoid semi-axis lying on the z-axis.
    :param plane: Plane that intersects ellipsoid.
    :return: Intersection ellipse, when FOUND is .TRUE.
        (found: NotFoundError if not found, or the flag returned last with no_found_check)"""
    return _context().inedpl(a, b, c, plane)

def inelpl(ellips, plane):
    """Find the intersection of an ellipse and a plane.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/inelpl.html
    
    :param ellips: A SPICE ellipse.
    :param plane: A SPICE plane.
    :return: Number of intersection points of plane and ellipse.; Intersection points.; Intersection points."""
    return _context().inelpl(ellips, plane)

def inrypl(vertex, direct, plane):
    """Find the intersection of a ray and a plane.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/inrypl.html
    
    :param vertex: Vertex and direction vector of ray.
    :param direct: Vertex and direction vector of ray.
    :param plane: A SPICE plane.
    :return: Number of intersection points of ray and plane.; Intersection point, if NXPTS = 1."""
    return _context().inrypl(vertex, direct, plane)

def inslad(elts, ne, loc, array, na):
    """Insert one or more elements into a double precision array at the indicated location.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/inslad.html
    
    :param elts: Elements to be inserted.
    :param ne: Number of elements to be inserted.
    :param loc: Location of the first inserted element.
    :param array: Input/output array.
    :param na: Number of elements in the input/output array.
    :return: Input/output array.; Number of elements in the input/output array."""
    return _context().inslad(elts, ne, loc, array, na)

def inslai(elts, ne, loc, array, na):
    """Insert one or more elements into an integer array at the indicated location.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/inslai.html
    
    :param elts: Elements to be inserted.
    :param ne: Number of elements to be inserted.
    :param loc: Location of the first inserted element.
    :param array: Input/output array.
    :param na: Number of elements in the input/output array.
    :return: Input/output array.; Number of elements in the input/output array."""
    return _context().inslai(elts, ne, loc, array, na)

def insrtd(item, inset=None):
    """Insert an item into a double precision set.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/insrtd.html
    
    :param item: Item to be inserted.
    :param inset: Insertion set.
    :return: Insertion set."""
    return _context().insrtd(item, inset)

def insrti(item, inset=None):
    """Insert an item into an integer set.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/insrti.html
    
    :param item: Item to be inserted.
    :param inset: Insertion set.
    :return: Insertion set."""
    return _context().insrti(item, inset)

def inssub(in_, sub, loc):
    """Insert a substring into a character string at a specified location.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/inssub.html
    
    :param in_: Input string.
    :param sub: Substring to be inserted.
    :param loc: Position at which substring is to be inserted.
    :return: Output string."""
    return _context().inssub(in_, sub, loc)

def int2hx(number):
    """Convert an integer to an equivalent signed hexadecimal string.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/int2hx.html
    
    :param number: Integer to be converted.
    :return: Equivalent hexadecimal string, left justified.; The length of the hexadecimal string produced."""
    return _context().int2hx(number)

def interd(a, b, c=None):
    """Intersect two double precision sets to form a third set.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/interd.html
    
    :param a: First input set.
    :param b: Second input set.
    :param c: Intersection of A and B.
    :return: Intersection of A and B."""
    return _context().interd(a, b, c)

def interi(a, b, c=None):
    """Intersect two integer sets to form a third set.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/interi.html
    
    :param a: First input set.
    :param b: Second input set.
    :param c: Intersection of A and B.
    :return: Intersection of A and B."""
    return _context().interi(a, b, c)

def intord(n):
    """Convert an integer to an equivalent written ordinal phrase. For example, convert 121 to 'ONE HUNDRED TWENTY-FIRST'.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/intord.html
    
    :param n: An integer (less than 10**12 in absolute value).
    :return: An English string representing the ordinal of N."""
    return _context().intord(n)

def inttxt(n):
    """Convert an integer to an equivalent written phrase. For example, convert 121 to 'ONE HUNDRED TWENTY-ONE'.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/inttxt.html
    
    :param n: An integer (less than 10**12 in absolute value).
    :return: An English string representing the cardinal of N."""
    return _context().inttxt(n)

def invort(m):
    """Construct the inverse of a 3x3 matrix with orthogonal columns and non-zero column norms using a numerically stable algorithm. The rows of the output matrix are the columns of the input matrix divided by the length squared of the corresponding columns.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/invort.html
    
    :param m: A 3x3 matrix.
    :return: M after transposition and scaling of rows."""
    return _context().invort(m)

def invstm(mat):
    """Return the inverse of a state transformation matrix.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/invstm.html
    
    :param mat: A state transformation matrix.
    :return: The inverse of MAT."""
    return _context().invstm(mat)

def ioerr(action, file, iostat):
    """Set the long error message equal to a standard I/O error message composed from an action, the name of a file, and a value of IOSTAT.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/ioerr.html
    
    :param action: Action which caused the error.
    :param file: The name of the file involved.
    :param iostat: The value of IOSTAT returned by ACTION."""
    return _context().ioerr(action, file, iostat)

def irfdef(index):
    """Specify a standard inertial reference frame as the default frame for a program.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/irfdef.html
    
    :param index: Index of default frame."""
    return _context().irfdef(index)

def irfnam(index):
    """Return the name of one of the standard inertial reference frames supported by `irfrot`.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/irfnam.html
    
    :param index: Index of standard inertial reference frame.
    :return: Name of frame."""
    return _context().irfnam(index)

def irfnum(name):
    """Return the index of one of the standard inertial reference frames supported by `irfrot`.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/irfnum.html
    
    :param name: Name of standard inertial reference frame.
    :return: Index of frame."""
    return _context().irfnum(name)

def irfrot(refa, refb):
    """Compute the matrix needed to rotate vectors between two standard inertial reference frames.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/irfrot.html
    
    :param refa: Indices of target reference frames (A,B).
    :param refb: Indices of target reference frames (A,B).
    :return: Rotation from frame A to frame B."""
    return _context().irfrot(refa, refb)

def irftrn(refa, refb):
    """Return the matrix that transforms vectors from one specified inertial reference frame to another.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/irftrn.html
    
    :param refa: Name of reference frame to transform vectors FROM.
    :param refb: Name of reference frame to transform vectors TO.
    :return: REFA-to-REFB transformation matrix."""
    return _context().irftrn(refa, refb)

def iso2utc(tstrng):
    """**Deprecated:** This routine is deprecated because all high-level time conversion routines (`str2et`, `utc2et`, `tparse`) were updated to accept ISO formatted times on input.  This routine is supported for purposes of backward compatibility only.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/iso2utc.html
    
    :param tstrng: String representing a calendar or julian date epoch
    :return: SPICELIB UTC string corresponding to TSTRNG; Error message if something went wrong."""
    return _context().iso2utc(tstrng)

def isopen(file):
    """Determine whether a named file is currently open.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/isopen.html
    
    :param file: Name of the file in question.
    :return: the result"""
    return _context().isopen(file)

def isrot(m, ntol, dtol):
    """Indicate whether a 3x3 matrix is a rotation matrix.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/isrot.html
    
    :param m: A matrix to be tested.
    :param ntol: Tolerance for the norms of the columns of M.
    :param dtol: Tolerance for the determinant of a matrix whose columns
    :return: the result"""
    return _context().isrot(m, ntol, dtol)

def jul2gr(year, month, day):
    """Convert Year Month and Day on the Julian Calendar to the Gregorian Calendar
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/jul2gr.html
    
    :param year: Year  of Julian Calendar/Gregorian Calendar
    :param month: Month of Julian Calendar/Gregorian Calendar
    :param day: Day of Month in Julian Calendar/Gregorian Calendar
    :return: Year  of Julian Calendar/Gregorian Calendar; Month of Julian Calendar/Gregorian Calendar; Day of Month in Julian Calendar/Gregorian Calendar; Day of Year in Gregorian Calendar"""
    return _context().jul2gr(year, month, day)

def kdata(which, kind, fillen=None, typlen=None, srclen=None):
    """Return data for the nth kernel that is among a list of specified kernel types.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/kdata.html
    
    :param which: Index of kernel to fetch from the list of kernels.
    :param kind: The kind of kernel to which fetches are limited.
    :param fillen: (SpiceyPy compatibility; ignored)
    :param typlen: (SpiceyPy compatibility; ignored)
    :param srclen: (SpiceyPy compatibility; ignored)
    :return: The name of the kernel file.; The type of the kernel.; Name of the source file used to load FILE.; The handle attached to FILE.
        (found: NotFoundError if not found, or the flag returned last with no_found_check)"""
    return _context().kdata(which, kind, fillen, typlen, srclen)

def kepleq(ml, h, k):
    """Solve the equinoctial version of Kepler's equation.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/kepleq.html
    
    :param ml: Mean longitude.
    :param h: h component of equinoctial elements.
    :param k: k component of equinoctial elements.
    :return: the result"""
    return _context().kepleq(ml, h, k)

def kernel_data(which, kind):
    """The data of the nth kernel of a kind loaded through FURNSH, with file names of any length (PEPPER; `kdata`, which truncates to its arguments' lengths).
    
    :param which: the index of the kernel among those of KIND
    :param kind: the kinds of kernel ('ALL', 'SPK', 'CK TEXT', ..., as `kdata`)
    :return: the file name (empty if not found); the kernel type: SPK, CK, PCK, DSK, EK, TEXT or META; the meta-kernel it was loaded from (empty if loaded directly); its handle (0 for a text or meta-kernel)
        (found: NotFoundError if not found, or the flag returned last with no_found_check)"""
    return _context().kernel_data(which, kind)

def kernel_format(file):
    """The loader and the description of a loaded kernel (PEPPER): for a file read by a kernel loader, the loader's name and the builder's description; for a programmatic kernel, a blank loader and its description (`(programmatic)` if none was set); for SPICE's own kernels, blanks. `found` is false if no kernel has this name.
    
    :param file: the kernel (as loaded)
    :return: the loader's name (blank if none); the description (blank if none)
        (found: NotFoundError if not found, or the flag returned last with no_found_check)"""
    return _context().kernel_format(file)

def kernel_info(file):
    """The data of a kernel loaded through FURNSH, with file names of any length (PEPPER; `kinfo`, which truncates to its arguments' lengths).
    
    :param file: the file name, as loaded
    :return: the kernel type: SPK, CK, PCK, DSK, EK, TEXT or META; the meta-kernel it was loaded from (empty if loaded directly); its handle (0 for a text or meta-kernel)
        (found: NotFoundError if not found, or the flag returned last with no_found_check)"""
    return _context().kernel_info(file)

def kinfo(file, typlen=None, srclen=None):
    """Return information about a specific kernel
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/kinfo.html
    
    :param file: Name of a kernel to fetch information for
    :param typlen: (SpiceyPy compatibility; ignored)
    :param srclen: (SpiceyPy compatibility; ignored)
    :return: The type of the kernel; Name of the source file used to load FILE.; The handle attached to FILE.
        (found: NotFoundError if not found, or the flag returned last with no_found_check)"""
    return _context().kinfo(file, typlen, srclen)

def kplfrm(frmcls, out_cell=None):
    """Return a SPICE set containing the frame IDs of all reference frames of a given class having specifications in the kernel pool.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/kplfrm.html
    
    :param frmcls: Frame class.
    :param out_cell: Set of ID codes of frames of the specified class.
    :return: Set of ID codes of frames of the specified class."""
    return _context().kplfrm(frmcls, out_cell)

def kpsolv(evec):
    """Solve the equation X = < EVEC, U(X) > where U(X) is the unit vector [ COS(X), SIN(X) ] and  < , > denotes the two-dimensional dot product.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/kpsolv.html
    
    :param evec: A 2-vector whose magnitude is less than 1.
    :return: the result"""
    return _context().kpsolv(evec)

def ktotal(kind):
    """Return the number of kernels of a specified type that are currently loaded via the FURNSH interface.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/ktotal.html
    
    :param kind: A list of kinds of kernels to count.
    :return: The number of kernels of type KIND."""
    return _context().ktotal(kind)

def latsrf(method, target, et, fixref, lonlat):
    """Map array of planetocentric longitude/latitude coordinate pairs to surface points on a specified target body.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/latsrf.html
    
    :param method: Computation method.
    :param target: Name of target body.
    :param et: Epoch in TDB seconds past J2000 TDB.
    :param fixref: Body-fixed, body-centered target body frame.
    :param lonlat: Array of longitude/latitude coordinate pairs.
    :return: Array of surface points."""
    return _context().latsrf(method, target, et, fixref, lonlat)

def lgresp(first, step, yvals, x):
    """Evaluate a Lagrange interpolating polynomial for a specified set of coordinate pairs whose first components are equally spaced, at a specified abscissa value.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/lgresp.html
    
    :param first: First abscissa value.
    :param step: Step size.
    :param yvals: Ordinate values.
    :param x: Point at which to interpolate the polynomial.
    :return: the result"""
    return _context().lgresp(first, step, yvals, x)

def lgrind(xvals, yvals, x):
    """Evaluate a Lagrange interpolating polynomial, for a specified set of coordinate pairs, at a specified abscissa value. Return both the value of the polynomial and its derivative.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/lgrind.html
    
    :param xvals: Abscissa values.
    :param yvals: Ordinate values.
    :param x: Point at which to interpolate the polynomial.
    :return: Polynomial value at X.; Polynomial derivative at X."""
    return _context().lgrind(xvals, yvals, x)

def lgrint(xvals, yvals, x):
    """Evaluate a Lagrange interpolating polynomial for a specified set of coordinate pairs, at a specified abscissa value.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/lgrint.html
    
    :param xvals: Abscissa values.
    :param yvals: Ordinate values.
    :param x: Point at which to interpolate the polynomial.
    :return: the result"""
    return _context().lgrint(xvals, yvals, x)

def limb_points(method, target, et, fixref, abcorr, corloc, obsrvr, refvec, rolstp, ncuts, schstp, soltol):
    """Limb points on a target body, without a limit on their number (PEPPER; `limbpt` without MAXN). The outputs are allocated to the number of points found.
    
    :param method: the computation method, as for `limbpt`
    :param target: the name of the target body
    :param et: the epoch (TDB seconds past J2000)
    :param fixref: the body-fixed, body-centered target body frame
    :param abcorr: the aberration correction
    :param corloc: the aberration correction locus
    :param obsrvr: the name of the observing body
    :param refvec: the reference vector for the cutting half-planes
    :param rolstp: the roll angular step between the cutting half-planes
    :param ncuts: the number of cutting half-planes
    :param schstp: the angular step size for searching (DSK shapes)
    :param soltol: the solution convergence tolerance (DSK shapes)
    :return: the number of points of each cut (size 0 after an error); the limb points, shape (3, n) (n = 0 after an error); the epochs of the points; the tangent vectors from the observer to the points, shape (3, n)"""
    return _context().limb_points(method, target, et, fixref, abcorr, corloc, obsrvr, refvec, rolstp, ncuts, schstp, soltol)

def loader_names():
    """The names of the kernel loaders registered on the context's instance (`spice_add_loader`), in the order of registration (PEPPER).
    
    :return: the loaders' names (upper case)"""
    return _context().loader_names()

def locln(unit, bmark, emark, line):
    """Locate a group of lines in a text file delimited by markers.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/locln.html
    
    :param unit: Logical unit connected to text file.
    :param bmark: Begin marker.
    :param emark: End marker.
    :param line: Workspace.
    :return: Workspace.; Beginning line.; Ending line.
        (found: NotFoundError if not found, or the flag returned last with no_found_check)"""
    return _context().locln(unit, bmark, emark, line)

def lspcn(body, et, abcorr):
    """Compute L_s, the planetocentric longitude of the sun, as seen from a specified body.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/lspcn.html
    
    :param body: Name of central body.
    :param et: Epoch in seconds past J2000 TDB.
    :param abcorr: Aberration correction.
    :return: the result"""
    return _context().lspcn(body, et, abcorr)

def ltime(etobs, obs, direct, targ):
    """Compute the transmission (or reception) time of a signal at a specified target, given the reception (or transmission) time at a specified observer. Also return the elapsed time between transmission and reception.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/ltime.html
    
    :param etobs: Epoch of a signal at some observer.
    :param obs: NAIF ID of some observer.
    :param direct: Direction the signal travels ( '->' or '<-' ).
    :param targ: NAIF ID of the target object.
    :return: Epoch of the signal at the target.; Time between transmit and receipt of the signal."""
    return _context().ltime(etobs, obs, direct, targ)

def lun2fn(lunit):
    """Map the logical unit of an open file to its associated filename.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/lun2fn.html
    
    :param lunit: A logical unit to be mapped to a filename.
    :return: Name of the file associated with LUNIT."""
    return _context().lun2fn(lunit)

def lx4dec(string, first):
    """Scan a string from a specified starting position for the end of a decimal number.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/lx4dec.html
    
    :param string: any character string
    :param first: first character to scan from in STRING
    :return: last character that is part of a decimal number; number of characters in the decimal number."""
    return _context().lx4dec(string, first)

def lx4num(string, first):
    """Scan a string from a specified starting position for the end of a number.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/lx4num.html
    
    :param string: any character string
    :param first: first character to scan from in STRING
    :return: last character that is part of a number; number of characters in the number."""
    return _context().lx4num(string, first)

def lx4sgn(string, first):
    """Scan a string from a specified starting position for the end of a signed integer.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/lx4sgn.html
    
    :param string: any character string
    :param first: first character to scan from in STRING
    :return: last character that is part of a signed integer; number of characters in the signed integer."""
    return _context().lx4sgn(string, first)

def lxcsid(hdchrs, tlchrs, idspec=None):
    """Set the acceptable characters that may appear in an identifier token.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/lxcsid.html
    
    :param hdchrs: Allowed head characters for identifiers.
    :param tlchrs: Allowed tail characters for identifiers.
    :param idspec: Identifier character specification.
    :return: Identifier character specification."""
    return _context().lxcsid(hdchrs, tlchrs, idspec)

def lxdfid(idspec=None):
    """Return the default specification for the characters that may appear in an identifier.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/lxdfid.html
    
    :param idspec: Identifier character specification.
    :return: Identifier character specification."""
    return _context().lxdfid(idspec)

def lxidnt(idspec, string, first):
    """Scan an identifier, starting from a specified character position.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/lxidnt.html
    
    :param idspec: Identifier character specification.
    :param string: String to be scanned.
    :param first: Character position at which to start scanning.
    :return: Character position of end of token.; Number of characters in token."""
    return _context().lxidnt(idspec, string, first)

def m2eul(r, axis3, axis2, axis1):
    """Factor a rotation matrix as a product of three rotations about specified coordinate axes.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/m2eul.html
    
    :param r: A rotation matrix to be factored.
    :param axis3: Numbers of third, second, and first rotation axes.
    :param axis2: Numbers of third, second, and first rotation axes.
    :param axis1: Numbers of third, second, and first rotation axes.
    :return: Third, second, and first Euler angles, in radians.; Third, second, and first Euler angles, in radians.; Third, second, and first Euler angles, in radians."""
    return _context().m2eul(r, axis3, axis2, axis1)

def m2q(r):
    """Find a unit quaternion corresponding to a specified rotation matrix.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/m2q.html
    
    :param r: A rotation matrix.
    :return: A unit quaternion representing R."""
    return _context().m2q(r)

def namfrm(frname):
    """Look up the frame ID code associated with a string.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/namfrm.html
    
    :param frname: The name of some reference frame
    :return: The SPICE ID code of the frame."""
    return _context().namfrm(frname)

def nearpt(positn, a, b, c):
    """Locate the point on the surface of an ellipsoid that is nearest to a specified position. Also return the altitude of the position above the ellipsoid.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/nearpt.html
    
    :param positn: Position of a point in body-fixed frame.
    :param a: Length of semi-axis parallel to x-axis.
    :param b: Length of semi-axis parallel to y-axis.
    :param c: Length on semi-axis parallel to z-axis.
    :return: Point on the ellipsoid closest to POSITN.; Altitude of POSITN above the ellipsoid."""
    return _context().nearpt(positn, a, b, c)

def npedln(a, b, c, linept, linedr):
    """Find nearest point on a triaxial ellipsoid to a specified line, and the distance from the ellipsoid to the line.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/npedln.html
    
    :param a: Length of ellipsoid's semi-axis in the x direction
    :param b: Length of ellipsoid's semi-axis in the y direction
    :param c: Length of ellipsoid's semi-axis in the z direction
    :param linept: Point on line
    :param linedr: Direction vector of line
    :return: Nearest point on ellipsoid to line; Distance of ellipsoid from line"""
    return _context().npedln(a, b, c, linept, linedr)

def npelpt(point, ellips):
    """Find the nearest point on an ellipse to a specified point, both in three-dimensional space, and find the distance between the ellipse and the point.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/npelpt.html
    
    :param point: Point whose distance to an ellipse is to be found.
    :param ellips: A SPICE ellipse.
    :return: Nearest point on ellipse to input point.; Distance of input point to ellipse."""
    return _context().npelpt(point, ellips)

def nplnpt(linpt, lindir, point):
    """Find the nearest point on a line to a specified point, and find the distance between the two points.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/nplnpt.html
    
    :param linpt: Point on a line and the line's direction vector.
    :param lindir: Point on a line and the line's direction vector.
    :param point: A second point.
    :return: Nearest point on the line to POINT.; Distance between POINT and PNEAR."""
    return _context().nplnpt(linpt, lindir, point)

def npsgpt(ep1, ep2, point):
    """Find the nearest point on a line segment to a given point.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/npsgpt.html
    
    :param ep1: Endpoints of a line segment.
    :param ep2: Endpoints of a line segment.
    :param point: A point in 3-dimensional space.
    :return: Nearest point on the line segment to POINT.; Distance between PNEAR and POINT."""
    return _context().npsgpt(ep1, ep2, point)

def nvc2pl(normal, constant):
    """Make a SPICE plane from a normal vector and a constant.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/nvc2pl.html
    
    :param normal: A normal vector and constant defining a plane.
    :param constant: A normal vector and constant defining a plane.
    :return: An array representing the plane."""
    return _context().nvc2pl(normal, constant)

def nvp2pl(normal, point):
    """Make a SPICE plane from a normal vector and a point.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/nvp2pl.html
    
    :param normal: A normal vector and a point defining a plane.
    :param point: A normal vector and a point defining a plane.
    :return: An array representing the plane."""
    return _context().nvp2pl(normal, point)

def occult(target1, shape1, frame1, target2, shape2, frame2, abcorr, observer, et):
    """Determine the occultation condition (not occulted, partially occulted, etc.) of one target relative to another target as seen by an observer at a given time.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/occult.html
    
    :param target1: Name or ID of first target.
    :param shape1: Type of shape model used for first target.
    :param frame1: Body-fixed, body-centered frame for first body.
    :param target2: Name or ID of second target.
    :param shape2: Type of shape model used for second target.
    :param frame2: Body-fixed, body-centered frame for second body.
    :param abcorr: Aberration correction flag.
    :param observer: Name or ID of the observer.
    :param et: Time of the observation (seconds past J2000).
    :return: Occultation identification code."""
    return _context().occult(target1, shape1, frame1, target2, shape2, frame2, abcorr, observer, et)

def ordd(item, inset):
    """Return the ordinal position of a given item in a set. If the item does not appear in the set, return zero.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/ordd.html
    
    :param item: An item to locate within a set.
    :param inset: A set to search for a given item.
    :return: the result"""
    return _context().ordd(item, inset)

def ordi(item, inset):
    """Return the ordinal position of a given item in a set. If the item does not appear in the set, return zero.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/ordi.html
    
    :param item: An item to locate within a set.
    :param inset: A set to search for a given item.
    :return: the result"""
    return _context().ordi(item, inset)

def oscelt(state, et, mu):
    """Determine the set of osculating conic orbital elements that corresponds to the state (position, velocity) of a body at some epoch.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/oscelt.html
    
    :param state: State of body at epoch of elements.
    :param et: Epoch of elements.
    :param mu: Gravitational parameter (GM) of primary body.
    :return: Equivalent conic elements."""
    return _context().oscelt(state, et, mu)

def oscltx(state, et, mu):
    """Determine the set of osculating conic orbital elements that corresponds to the state (position, velocity) of a body at some epoch. In additional to the classical elements, return the true anomaly, semi-major axis, and period, if applicable.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/oscltx.html
    
    :param state: State of body at epoch of elements.
    :param et: Epoch of elements.
    :param mu: Gravitational parameter (GM) of primary body.
    :return: Extended set of classical conic elements."""
    return _context().oscltx(state, et, mu)

def partof(ma):
    """Solve the time of flight equation MA = D + (D**3) / 3 for the parabolic eccentric anomaly D, given mean anomaly.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/partof.html
    
    :param ma: Mean anomaly at epoch.
    :return: Parabolic eccentric anomaly."""
    return _context().partof(ma)

def pck03a(handle, ncsets, coeffs, epochs):
    """Add data to a type 03 PCK segment in the binary PCK file associated with HANDLE. See also `pck03b` and `pck03e`.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/pck03a.html
    
    :param handle: The handle of a DAF file open for writing.
    :param ncsets: The number of Cheby coefficient sets and epochs.
    :param coeffs: The collection of Cheby coefficient sets.
    :param epochs: The epochs associated with the element sets."""
    return _context().pck03a(handle, ncsets, coeffs, epochs)

def pck03b(handle, segid, body, frame, first, last, chbdeg):
    """Begin a type 03 PCK segment in the binary PCK file associated with HANDLE. See also `pck03a` and `pck03e`.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/pck03b.html
    
    :param handle: The handle of a DAF file open for writing.
    :param segid: The string to use for segment identifier.
    :param body: The NAIF ID code for the body of the segment.
    :param frame: The inertial frame for this segment.
    :param first: The first epoch for which the segment is valid.
    :param last: The last epoch for which the segment is valid.
    :param chbdeg: The degree of the Chebyshev Polynomial used."""
    return _context().pck03b(handle, segid, body, frame, first, last, chbdeg)

def pck03e(handle):
    """End the type 03 PCK segment currently being written to the binary PCK file associated with HANDLE. See also `pck03b` and `pck03a`.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/pck03e.html
    
    :param handle: The handle of a binary PCK file open for writing."""
    return _context().pck03e(handle)

def pck_coverage(file, frame):
    """The coverage of a frame in a binary PCK file (PEPPER; `pckcov` without a window cell).
    
    :param file: the binary PCK file
    :param frame: the frame class ID code
    :return: the coverage, shape (2, n) (n = 0 after an error)"""
    return _context().pck_coverage(file, frame)

def pck_frames(file):
    """The frames of a binary PCK file (PEPPER; `pckfrm` without a set cell): their class ID codes, sorted, without duplicates.
    
    :param file: the binary PCK file
    :return: the frame class ID codes (size 0 after an error)"""
    return _context().pck_frames(file)

def pckcls(handle):
    """Close an open PCK file.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/pckcls.html
    
    :param handle: Handle of the PCK file to be closed."""
    return _context().pckcls(handle)

def pckcov(pck, idcode, cover=None):
    """Find the coverage window for a specified reference frame in a specified binary PCK file.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/pckcov.html
    
    :param pck: Name of PCK file.
    :param idcode: Class ID code of PCK reference frame.
    :param cover: Window giving coverage in PCKFNM for IDCODE.
    :return: Window giving coverage in PCKFNM for IDCODE."""
    return _context().pckcov(pck, idcode, cover)

def pcke02(et, record):
    """Evaluate a single PCK data record from a segment of type 2 (Chebyshev Polynomials, position only).
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/pcke02.html
    
    :param et: Epoch.
    :param record: Data record.
    :return: Euler angles and their derivatives."""
    return _context().pcke02(et, record)

def pcke03(et, record):
    """Evaluate a single PCK data record from a segment of type 03 (Variable width Chebyshev Polynomials for RA, DEC, and W) to obtain a state transformation matrix.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/pcke03.html
    
    :param et: Target epoch state transformation.
    :param record: Data record valid for epoch ET.
    :return: State transformation matrix at epoch ET."""
    return _context().pcke03(et, record)

def pcke20(et, record):
    """Evaluate a single PCK data record from a segment of type 20 (Chebyshev Polynomials, rotation derivative only).
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/pcke20.html
    
    :param et: Evaluation epoch.
    :param record: Data record.
    :return: Euler angles and their derivatives."""
    return _context().pcke20(et, record)

def pckeul(body, et):
    """This routine is obsolete. It supports only the type 02 binary PCK format. It is maintained only for backward compatibility
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/pckeul.html
    
    :param body: ID code of body
    :param et: Epoch of transformation
    :return: Name of inertial ref. frame of state; Euler angles and their derivatives.
        (found: NotFoundError if not found, or the flag returned last with no_found_check)"""
    return _context().pckeul(body, et)

def pckfrm(pck, ids=None):
    """Find the set of reference frame class ID codes of all frames in a specified binary PCK file.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/pckfrm.html
    
    :param pck: Name of PCK file.
    :param ids: Set of frame class ID codes of frames in PCK file.
    :return: Set of frame class ID codes of frames in PCK file."""
    return _context().pckfrm(pck, ids)

def pckmat(body, et):
    """Return the name of an inertial reference frame and the 6 x 6 state transformation matrix from that frame to the body fixed frame of a given body at a specified epoch.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/pckmat.html
    
    :param body: ID code of some body.
    :param et: Epoch of transformation.
    :return: Integer code for inertial reference frame.; Transformation from Inertial to PM for BODY at ET.
        (found: NotFoundError if not found, or the flag returned last with no_found_check)"""
    return _context().pckmat(body, et)

def pckopn(name, ifname, ncomch):
    """Create a new PCK file, returning the handle of the opened file.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/pckopn.html
    
    :param name: The name of the PCK file to be opened.
    :param ifname: The internal filename for the PCK.
    :param ncomch: The number of characters to reserve for comments.
    :return: The handle of the opened PCK file."""
    return _context().pckopn(name, ifname, ncomch)

def pckuds(descr):
    """Unpack the contents of a PCK segment descriptor
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/pckuds.html
    
    :param descr: A PCK segment descriptor.
    :return: The NAIF ID code for the body of the segment.; The code for the inertial frame of this segment.; The type of PCK segment.; The first epoch for which the segment is valid.; The last  epoch for which the segment is valid.; Beginning DAF address of the segment.; Ending DAF address of the segment."""
    return _context().pckuds(descr)

def pckw02(handle, classid, frname, first, last, segid, intlen, n, polydg, cdata, btime):
    """Write a type 2 segment to a PCK binary file given the file handle, body-fixed frame class ID, frame, time range covered by the segment, and the Chebyshev polynomial coefficients.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/pckw02.html
    
    :param handle: Handle of binary PCK file open for writing.
    :param classid: Frame class ID of body-fixed frame.
    :param frname: Reference frame name.
    :param first: Start time of interval covered by segment.
    :param last: End time of interval covered by segment.
    :param segid: Segment identifier.
    :param intlen: Length of time covered by logical record.
    :param n: Number of logical records in segment.
    :param polydg: Chebyshev polynomial degree.
    :param cdata: Array of Chebyshev coefficients.
    :param btime: Begin time of first logical record."""
    return _context().pckw02(handle, classid, frname, first, last, segid, intlen, n, polydg, cdata, btime)

def pckw20(handle, clssid, frame, first, last, segid, intlen, n, polydg, cdata, ascale, tscale, initjd, initfr):
    """Write a type 20 segment to a PCK file.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/pckw20.html
    
    :param handle: Handle of PCK file open for writing.
    :param clssid: NAIF PCK frame class ID.
    :param frame: Reference frame name.
    :param first: Start time of interval covered by segment.
    :param last: End time of interval covered by segment.
    :param segid: Segment identifier.
    :param intlen: Length of time covered by logical record (days).
    :param n: Number of logical records in segment.
    :param polydg: Chebyshev polynomial degree.
    :param cdata: Array of Chebyshev coefficients and angles.
    :param ascale: Angular scale of data.
    :param tscale: Time scale of data.
    :param initjd: Integer part of begin time (TDB Julian date) of first record.
    :param initfr: Fractional part of begin time (TDB Julian date) of first record."""
    return _context().pckw20(handle, clssid, frame, first, last, segid, intlen, n, polydg, cdata, ascale, tscale, initjd, initfr)

def pgrrec(body, lon, lat, alt, re, f):
    """Convert planetographic coordinates to rectangular coordinates.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/pgrrec.html
    
    :param body: Body with which coordinate system is associated.
    :param lon: Planetographic longitude of a point (radians).
    :param lat: Planetographic latitude of a point (radians).
    :param alt: Altitude of a point above reference spheroid.
    :param re: Equatorial radius of the reference spheroid.
    :param f: Flattening coefficient.
    :return: Rectangular coordinates of the point."""
    return _context().pgrrec(body, lon, lat, alt, re, f)

def phaseq(et, target, illmn, obsrvr, abcorr):
    """Compute the apparent phase angle for a target, observer, illuminator set of ephemeris objects.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/phaseq.html
    
    :param et: Ephemeris seconds past J2000 TDB.
    :param target: Target body name.
    :param illmn: Illuminating body name.
    :param obsrvr: Observer body.
    :param abcorr: Aberration correction flag.
    :return: the result"""
    return _context().phaseq(et, target, illmn, obsrvr, abcorr)

def pjelpl(elin, plane):
    """Project an ellipse onto a plane, orthogonally.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/pjelpl.html
    
    :param elin: A SPICE ellipse to be projected.
    :param plane: A plane onto which ELIN is to be projected.
    :return: A SPICE ellipse resulting from the projection."""
    return _context().pjelpl(elin, plane)

def plnsns(bodid):
    """Indicate for a specified body whether planetographic and planetocentric longitude increase in the same sense.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/plnsns.html
    
    :param bodid: is the NAIF integer ID code of some solar system object.
    :return: the result"""
    return _context().plnsns(bodid)

def pltar(vrtces, plates):
    """Compute the total area of a collection of triangular plates.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/pltar.html
    
    :param vrtces: Array of vertices.
    :param plates: Array of plates.
    :return: the result"""
    return _context().pltar(vrtces, plates)

def pltnp(point, v1, v2, v3):
    """Find the nearest point on a triangular plate to a given point.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/pltnp.html
    
    :param point: A point in 3-dimensional space.
    :param v1: Vertices of a triangular plate.
    :param v2: Vertices of a triangular plate.
    :param v3: Vertices of a triangular plate.
    :return: Nearest point on the plate to POINT.; Distance between PNEAR and POINT."""
    return _context().pltnp(point, v1, v2, v3)

def pltvol(vrtces, plates):
    """Compute the volume of a three-dimensional region bounded by a collection of triangular plates.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/pltvol.html
    
    :param vrtces: Array of vertices.
    :param plates: Array of plates.
    :return: the result"""
    return _context().pltvol(vrtces, plates)

def pool_defined_by(source):
    """The kernel variables that a source assigned (PEPPER; the reverse of `pool_sources`): the variables with an assignment in effect from it, in the order of `gnpool`. A variable that a later `=` from another source replaced is not among them.
    
    :param source: the kernel file, named as it was loaded, or a tag such as (PDPOOL)
    :return: the variables it assigned"""
    return _context().pool_defined_by(source)

def pool_integers(name):
    """All the values of a numeric kernel variable, rounded to integers (PEPPER; `gipool` with the size taken from the pool).
    
    :param name: the name of the variable
    :return: its values (size 0 if not found)
        (found: NotFoundError if not found, or the flag returned last with no_found_check)"""
    return _context().pool_integers(name)

def pool_names(template_):
    """The names of the kernel variables that match a template (wildcards * and %, case-insensitive, as `gnpool`), of any length, in the order of `gnpool` (PEPPER).
    
    :param template_: the template
    :return: the matching names"""
    return _context().pool_names(template_)

def pool_sources(name):
    """Where the values of a kernel variable came from (PEPPER): the assignments in effect, in order, with the source of each, the line where it begins, and the index of its first value. An `=` assignment replaces the values, so it is the first one; each `+=` (or `'+NAME'` of a JSON kernel) that followed adds one.
    
    :param name: the name of the variable
    :return: the source of each assignment (size 0 if not found); the line where each begins (0 for PCPOOL, PDPOOL, PIPOOL, add_frame); the index of the first value each gave
        (found: NotFoundError if not found, or the flag returned last with no_found_check)"""
    return _context().pool_sources(name)

def pool_string(name, nth):
    """Return one string value of a character kernel variable, of any length (PEPPER; `gcpool` truncates to the length of its output).
    
    :param name: the name of the variable
    :param nth: the index of the value
    :return: the value (empty if not found); the number of values of the variable (0 if it is not a character variable)
        (found: NotFoundError if not found, or the flag returned last with no_found_check)"""
    return _context().pool_string(name, nth)

def pool_strings(name):
    """All the values of a character kernel variable, each of any length (PEPPER; `gcpool` with the size taken from the pool).
    
    :param name: the name of the variable
    :return: its values (size 0 if not found)
        (found: NotFoundError if not found, or the flag returned last with no_found_check)"""
    return _context().pool_strings(name)

def pool_values(name):
    """All the values of a numeric kernel variable (PEPPER; `gdpool` with the size taken from the pool).
    
    :param name: the name of the variable
    :return: its values (size 0 if not found)
        (found: NotFoundError if not found, or the flag returned last with no_found_check)"""
    return _context().pool_values(name)

def pool_write_json(unit):
    """Write the kernel pool as a JSON kernel (PEPPER; the JSON counterpart of `wrpool`): one `'NAME': value` per variable, in the order of `gnpool`, each with a `//` comment naming its sources and lines (`pool_sources`). Loading the file (`spice_furnsh`, as a `*.json` kernel) gives the same variables and values: the numbers are written with as many digits as they need to read back exactly (integers without a fraction), and times as the numbers they became.
    
    :param unit: the unit of the file: open for formatted sequential writing"""
    return _context().pool_write_json(unit)

def prompt(dspmsg):
    """Prompt a user for keyboard input.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/prompt.html
    
    :param dspmsg: The prompt to use when asking for input.
    :return: The response typed by a user."""
    return _context().prompt(dspmsg)

def prop2b(gm, pvinit, dt):
    """Compute the state of a massless body at time t_0 + DT by applying the two-body force model to a given central mass and a given body state at time t_0.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/prop2b.html
    
    :param gm: Gravity of the central mass.
    :param pvinit: Initial state from which to propagate a state.
    :param dt: Time offset from initial state to propagate to.
    :return: The propagated state."""
    return _context().prop2b(gm, pvinit, dt)

def prsdp(string):
    """Parse a string as a double precision number, encapsulating error handling.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/prsdp.html
    
    :param string: String representing a numeric value.
    :return: D.p. value obtained by parsing STRING."""
    return _context().prsdp(string)

def prsint(string):
    """Parse a string as an integer, encapsulating error handling.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/prsint.html
    
    :param string: String representing a numeric value.
    :return: Integer value obtained by parsing STRING."""
    return _context().prsint(string)

def prtdec(string):
    """Decode a character string encoded by `prtenc`.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/prtdec.html
    
    :param string: Encoded character string.
    :return: Decoded number."""
    return _context().prtdec(string)

def prtenc(number):
    """Encode a nonnegative integer number into a character string, portably, using 128 as the base for encoding.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/prtenc.html
    
    :param number: Number to be encoded.
    :return: Encoded string."""
    return _context().prtenc(number)

def psv2pl(point, span1, span2):
    """Make a SPICE plane from a point and two spanning vectors.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/psv2pl.html
    
    :param point: A point and two spanning vectors defining a
    :param span1: A point and two spanning vectors defining a
    :param span2: A point and two spanning vectors defining a
    :return: An array representing the plane."""
    return _context().psv2pl(point, span1, span2)

def pxform(fromstr, tostr, et):
    """Return the matrix that transforms position vectors from one specified frame to another at a specified epoch.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/pxform.html
    
    :param fromstr: Name of the frame to transform from.
    :param tostr: Name of the frame to transform to.
    :param et: Epoch of the rotation matrix.
    :return: A rotation matrix."""
    return _context().pxform(fromstr, tostr, et)

def pxfrm2(frame_from, frame_to, etfrom, etto):
    """Return the 3x3 matrix that transforms position vectors from one specified frame at a specified epoch to another specified frame at another specified epoch.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/pxfrm2.html
    
    :param frame_from: Name of the frame to transform from.
    :param frame_to: Name of the frame to transform to.
    :param etfrom: Evaluation time of FROM frame.
    :param etto: Evaluation time of TO frame.
    :return: A position transformation matrix from frame FROM to frame TO."""
    return _context().pxfrm2(frame_from, frame_to, etfrom, etto)

def qderiv(f0, f2, delta):
    """Estimate the derivative of a function by finding the derivative of a quadratic approximating function. This derivative estimate is equivalent to that found by computing the average of forward and backward differences.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/qderiv.html
    
    :param f0: Function values at left endpoint.
    :param f2: Function values at right endpoint.
    :param delta: Separation of abscissa points.
    :return: Derivative vector."""
    return _context().qderiv(f0, f2, delta)

def raxisa(matrix):
    """Compute the axis of the rotation given by an input matrix and the angle of the rotation about that axis.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/raxisa.html
    
    :param matrix: 3x3 rotation matrix in double precision.
    :return: Axis of the rotation.; Angle through which the rotation is performed."""
    return _context().raxisa(matrix)

def rdkdat():
    """Read the next line of data from a SPICE ASCII kernel file.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/rdkdat.html
    
    :return: Next line of kernel data.; End of file indicator."""
    return _context().rdkdat()

def rdklin():
    """Return the name of file and line number of the last line read by the entry point `rdkdat`.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/rdklin.html
    
    :return: The name of the current file that is being read.; The line number of the last line read in the file."""
    return _context().rdklin()

def rdknew(kernel):
    """Open and initialize a SPICE ASCII kernel file.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/rdknew.html
    
    :param kernel: Kernel file."""
    return _context().rdknew(kernel)

def rdnbl(file):
    """Read the next non-blank line of text from a text file.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/rdnbl.html
    
    :param file: Input text file.
    :return: Next non-blank line from the input text file.; End-of-file indicator."""
    return _context().rdnbl(file)

def rdtext(file, lenout=None):
    """Read the next line of text from a text file.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/rdtext.html
    
    :param file: Name of text file.
    :param lenout: (SpiceyPy compatibility; ignored)
    :return: Next line from the text file.; End-of-file indicator."""
    return _context().rdtext(file, lenout)

def readln(unit):
    """Read a single line of text from the Fortran logical unit UNIT, reporting the end of file if it occurs.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/readln.html
    
    :param unit: The Fortran unit number to use for input.
    :return: The line read from the file.; A logical flag indicating the end of file."""
    return _context().readln(unit)

def recgeo(rectan, re, f):
    """Convert from rectangular coordinates to geodetic coordinates.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/recgeo.html
    
    :param rectan: Rectangular coordinates of a point.
    :param re: Equatorial radius of the reference spheroid.
    :param f: Flattening coefficient.
    :return: Geodetic longitude of the point (radians).; Geodetic latitude  of the point (radians).; Altitude of the point above reference spheroid."""
    return _context().recgeo(rectan, re, f)

def recpgr(body, rectan, re, f):
    """Convert rectangular coordinates to planetographic coordinates.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/recpgr.html
    
    :param body: Body with which coordinate system is associated.
    :param rectan: Rectangular coordinates of a point.
    :param re: Equatorial radius of the reference spheroid.
    :param f: Flattening coefficient.
    :return: Planetographic longitude of the point (radians).; Planetographic latitude of the point (radians).; Altitude of the point above reference spheroid."""
    return _context().recpgr(body, rectan, re, f)

def refchg(frame1, frame2, et):
    """Return the transformation matrix from one frame to another.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/refchg.html
    
    :param frame1: the frame id-code for some reference frame
    :param frame2: the frame id-code for some reference frame
    :param et: an epoch in TDB seconds past J2000.
    :return: a rotation matrix"""
    return _context().refchg(frame1, frame2, et)

def remlad(ne, loc, array, na):
    """Remove one or more elements from a double precision array at the indicated location.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/remlad.html
    
    :param ne: Number of elements to be removed.
    :param loc: Location of the first removed element.
    :param array: Input/output array.
    :param na: Number of elements in the input/output array.
    :return: Input/output array.; Number of elements in the input/output array."""
    return _context().remlad(ne, loc, array, na)

def remlai(ne, loc, array, na):
    """Remove one or more elements from an integer array at the indicated location.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/remlai.html
    
    :param ne: Number of elements to be removed.
    :param loc: Location of the first removed element.
    :param array: Input/output array.
    :param na: Number of elements in the input/output array.
    :return: Input/output array.; Number of elements in the input/output array."""
    return _context().remlai(ne, loc, array, na)

def removd(item, inset=None):
    """Remove an item from a double precision set.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/removd.html
    
    :param item: Item to be removed.
    :param inset: Removal set.
    :return: Removal set."""
    return _context().removd(item, inset)

def removi(item, inset=None):
    """Remove an item from an integer set.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/removi.html
    
    :param item: Item to be removed.
    :param inset: Removal set.
    :return: Removal set."""
    return _context().removi(item, inset)

def remsub(in_, left, right):
    """Remove the substring (LEFT:RIGHT) from a character string.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/remsub.html
    
    :param in_: Input string.
    :param left: Position of first character to be removed.
    :param right: Position of last character to be removed.
    :return: Output string."""
    return _context().remsub(in_, left, right)

def repmct(instr, marker, value, repcase, lenout=None):
    """Replace a marker with the text representation of a cardinal number.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/repmct.html
    
    :param instr: Input string.
    :param marker: Marker to be replaced.
    :param value: Replacement value.
    :param repcase: Case of replacement text.
    :param lenout: (SpiceyPy compatibility; ignored)
    :return: Output string."""
    return _context().repmct(instr, marker, value, repcase, lenout)

def repmd(instr, marker, value, sigdig):
    """Replace a marker with a double precision number.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/repmd.html
    
    :param instr: Input string.
    :param marker: Marker to be replaced.
    :param value: Replacement value.
    :param sigdig: Significant digits in replacement text.
    :return: Output string."""
    return _context().repmd(instr, marker, value, sigdig)

def repmf(instr, marker, value, sigdig, informat, lenout=None):
    """Replace a marker in a string with a formatted double precision value.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/repmf.html
    
    :param instr: Input string.
    :param marker: Marker to be replaced.
    :param value: Replacement value.
    :param sigdig: Significant digits in replacement text.
    :param informat: Format: 'E' or 'F'.
    :param lenout: (SpiceyPy compatibility; ignored)
    :return: Output string."""
    return _context().repmf(instr, marker, value, sigdig, informat, lenout)

def repmi(instr, marker, value, lenout=None):
    """Replace a marker with an integer.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/repmi.html
    
    :param instr: Input string.
    :param marker: Marker to be replaced.
    :param value: Replacement value.
    :param lenout: (SpiceyPy compatibility; ignored)
    :return: Output string."""
    return _context().repmi(instr, marker, value, lenout)

def repml(in_, marker, value, rtcase):
    """Replace a marker with the text representation of a logical value.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/repml.html
    
    :param in_: Input string.
    :param marker: Marker to be replaced.
    :param value: Replacement logical value.
    :param rtcase: Case of replacement text.
    :return: Output string."""
    return _context().repml(in_, marker, value, rtcase)

def repmot(instr, marker, value, repcase, lenout=None):
    """Replace a marker with the text representation of an ordinal number.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/repmot.html
    
    :param instr: Input string.
    :param marker: Marker to be replaced.
    :param value: Replacement value.
    :param repcase: Case of replacement text.
    :param lenout: (SpiceyPy compatibility; ignored)
    :return: Output string."""
    return _context().repmot(instr, marker, value, repcase, lenout)

def repsub(in_, left, right, string):
    """Replace the substring (LEFT:RIGHT) with a string of any length.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/repsub.html
    
    :param in_: Input string.
    :param left: Ends of substring to be replaced.
    :param right: Ends of substring to be replaced.
    :param string: Replacement string.
    :return: Resulting string."""
    return _context().repsub(in_, left, right, string)

def rmaind(num, denom):
    """Compute the integer quotient and non-negative remainder of NUM and DENOM.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/rmaind.html
    
    :param num: Numerator used to compute quotient and remainder.
    :param denom: Denominator used to compute quotient and remainder.
    :return: Integer portion of the quotient NUM/DENOM.; Remainder of the quotient NUM/DENOM."""
    return _context().rmaind(num, denom)

def rmaini(num, denom):
    """Compute the integer quotient and non-negative remainder of NUM and DENOM.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/rmaini.html
    
    :param num: Numerator used to compute quotient and remainder.
    :param denom: Denominator used to compute quotient and remainder.
    :return: Integer portion of the quotient NUM/DENOM.; Remainder of the quotient NUM/DENOM."""
    return _context().rmaini(num, denom)

def rotate(angle, iaxis):
    """Calculate the 3x3 rotation matrix generated by a rotation of a specified angle about a specified axis. This rotation is thought of as rotating the coordinate system.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/rotate.html
    
    :param angle: Angle of rotation (radians).
    :param iaxis: Axis of rotation (X=1, Y=2, Z=3).
    :return: Resulting rotation matrix [ANGLE] IAXIS"""
    return _context().rotate(angle, iaxis)

def rotget(infrm, et):
    """Find the rotation from a user specified frame to another frame at a user specified epoch.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/rotget.html
    
    :param infrm: The integer code for a SPICE reference frame.
    :param et: An epoch in seconds past J2000.
    :return: A rotation matrix.; The frame that `rotate` transforms INFRM to.
        (found: NotFoundError if not found, or the flag returned last with no_found_check)"""
    return _context().rotget(infrm, et)

def rotmat(m1, angle, iaxis):
    """Apply a rotation of ANGLE radians about axis IAXIS to a matrix. This rotation is thought of as rotating the coordinate system.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/rotmat.html
    
    :param m1: Matrix to be rotated.
    :param angle: Angle of rotation (radians).
    :param iaxis: Axis of rotation (X=1, Y=2, Z=3).
    :return: Resulting rotated matrix [ANGLE]      * M1 IAXIS"""
    return _context().rotmat(m1, angle, iaxis)

def rotvec(v1, angle, iaxis):
    """Transform a vector to a new reference frame rotated by ANGLE radians about axis IAXIS. This transformation rotates V1 by -ANGLE radians about the specified axis.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/rotvec.html
    
    :param v1: Vector whose coordinate system is to be rotated.
    :param angle: Angle of rotation in radians.
    :param iaxis: Axis of rotation (X=1, Y=2, Z=3).
    :return: Resulting vector expressed in the new frame."""
    return _context().rotvec(v1, angle, iaxis)

def rquad(a, b, c):
    """Find the roots of a quadratic equation.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/rquad.html
    
    :param a: Coefficient of quadratic term.
    :param b: Coefficient of linear term.
    :param c: Constant.
    :return: Root built from positive discriminant term.; Root built from negative discriminant term."""
    return _context().rquad(a, b, c)

def saelgv(vec1, vec2):
    """Find semi-axis vectors of an ellipse generated by two arbitrary three-dimensional vectors.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/saelgv.html
    
    :param vec1: Two vectors used to generate an ellipse.
    :param vec2: Two vectors used to generate an ellipse.
    :return: Semi-major axis of ellipse.; Semi-minor axis of ellipse."""
    return _context().saelgv(vec1, vec2)

def scardd(card, cell=None):
    """Set the cardinality of a double precision cell.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/scardd.html
    
    :param card: Cardinality of (number of elements in) the cell.
    :param cell: The cell.
    :return: The cell."""
    return _context().scardd(card, cell)

def scardi(card, cell=None):
    """Set the cardinality of an integer cell.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/scardi.html
    
    :param card: Cardinality of (number of elements in) the cell.
    :param cell: The cell.
    :return: The cell."""
    return _context().scardi(card, cell)

def scdecd(sc, sclkdp, lenout=None, mxpart=None):
    """Convert a double precision encoding of spacecraft clock time into a character representation.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/scdecd.html
    
    :param sc: NAIF spacecraft identification code.
    :param sclkdp: Encoded representation of a spacecraft clock count.
    :param lenout: (SpiceyPy compatibility; ignored)
    :param mxpart: (SpiceyPy compatibility; ignored)
    :return: Character representation of a clock count."""
    return _context().scdecd(sc, sclkdp, lenout, mxpart)

def sce2c(sc, et):
    """Convert ephemeris seconds past J2000 (ET) to continuous encoded spacecraft clock (`ticks').  Non-integral tick values may be returned.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/sce2c.html
    
    :param sc: NAIF spacecraft ID code.
    :param et: Ephemeris time, seconds past J2000.
    :return: SCLK, encoded as ticks since spacecraft clock start. SCLKDP need not be integral."""
    return _context().sce2c(sc, et)

def sce2s(sc, et, lenout=None):
    """Convert an epoch specified as ephemeris seconds past J2000 (ET) to a character string representation of a spacecraft clock value (SCLK).
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/sce2s.html
    
    :param sc: NAIF spacecraft clock ID code.
    :param et: Ephemeris time, specified as seconds past J2000.
    :param lenout: (SpiceyPy compatibility; ignored)
    :return: An SCLK string."""
    return _context().sce2s(sc, et, lenout)

def sce2t(sc, et):
    """Convert ephemeris seconds past J2000 (ET) to integral encoded spacecraft clock (`ticks'). For conversion to fractional ticks, (required for C-kernel production), see the routine `sce2c`.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/sce2t.html
    
    :param sc: NAIF spacecraft ID code.
    :param et: Ephemeris time, seconds past J2000.
    :return: SCLK, encoded as ticks since spacecraft clock start."""
    return _context().sce2t(sc, et)

def scec01(sc, et):
    """Convert ephemeris seconds past J2000 (ET) to continuous encoded type 1 spacecraft clock (`ticks').  The output value need not be integral.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/scec01.html
    
    :param sc: NAIF spacecraft ID code.
    :param et: Ephemeris time, seconds past J2000.
    :return: Type 1 SCLK, encoded as continuous ticks since clock start."""
    return _context().scec01(sc, et)

def scencd(sc, sclkch, mxpart=None):
    """Encode a character representation of spacecraft clock time into a double precision number.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/scencd.html
    
    :param sc: NAIF spacecraft identification code.
    :param sclkch: Character representation of a spacecraft clock.
    :param mxpart: (SpiceyPy compatibility; ignored)
    :return: Encoded representation of the clock count."""
    return _context().scencd(sc, sclkch, mxpart)

def scet01(sc, et):
    """Convert ephemeris seconds past J2000 (ET) to discrete encoded type 1 spacecraft clock (`ticks').
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/scet01.html
    
    :param sc: NAIF spacecraft ID code.
    :param et: Ephemeris time, seconds past J2000.
    :return: Type 1 SCLK, encoded as ticks since clock start."""
    return _context().scet01(sc, et)

def scfm01(sc, ticks):
    """Convert a number of ticks to an equivalent type 1 spacecraft clock string.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/scfm01.html
    
    :param sc: NAIF spacecraft identification code.
    :param ticks: Number of ticks represented by a clock count.
    :return: Character string representation of the clock count."""
    return _context().scfm01(sc, ticks)

def scfmt(sc, ticks, lenout=None):
    """Convert encoded spacecraft clock ticks to character clock format.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/scfmt.html
    
    :param sc: NAIF spacecraft identification code.
    :param ticks: Spacecraft clock count encoded representation.
    :param lenout: (SpiceyPy compatibility; ignored)
    :return: Character representation of a clock count."""
    return _context().scfmt(sc, ticks, lenout)

def scid2n(clkid):
    """Convert a NAIF integer code for a spacecraft clock to an SCLK name string.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/scid2n.html
    
    :param clkid: NAIF integer code of spacecraft clock.
    :return: String giving spacecraft clock name.
        (found: NotFoundError if not found, or the flag returned last with no_found_check)"""
    return _context().scid2n(clkid)

def scn2id(clknam):
    """Convert an SCLK name string to a NAIF integer code.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/scn2id.html
    
    :param clknam: String giving spacecraft clock name.
    :return: NAIF integer code of spacecraft clock.
        (found: NotFoundError if not found, or the flag returned last with no_found_check)"""
    return _context().scn2id(clknam)

def scpars(sc, sclkch):
    """Parse a character representation of spacecraft clock time and encode it as a double precision number.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/scpars.html
    
    :param sc: NAIF spacecraft identification code.
    :param sclkch: Character representation of a spacecraft clock.
    :return: Flag to indicate if string parsed correctly.; Error message if string did not parse.; Encoded representation of the clock count."""
    return _context().scpars(sc, sclkch)

def scpart(sc):
    """Get spacecraft clock partition information from a spacecraft clock kernel file.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/scpart.html
    
    :param sc: NAIF spacecraft identification code.
    :return: The number of spacecraft clock partitions.; Array of partition start times.; Array of partition stop times."""
    return _context().scpart(sc)

def scps01(sc, clkstr):
    """Convert a character representation of a type 1 spacecraft clock count to ticks.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/scps01.html
    
    :param sc: NAIF spacecraft ID code.
    :param clkstr: Character representation of a clock count.
    :return: Parsing error flag.; Output message for parsing error.; Number of ticks represented by the clock count."""
    return _context().scps01(sc, clkstr)

def scs2e(sc, sclkch):
    """Convert a spacecraft clock string to ephemeris seconds past J2000 (ET).
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/scs2e.html
    
    :param sc: NAIF integer code for a spacecraft.
    :param sclkch: An SCLK string.
    :return: Ephemeris time, seconds past J2000."""
    return _context().scs2e(sc, sclkch)

def sct2e(sc, sclkdp):
    """Convert encoded spacecraft clock (`ticks') to ephemeris seconds past J2000 (ET).
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/sct2e.html
    
    :param sc: NAIF spacecraft ID code.
    :param sclkdp: SCLK, encoded as ticks since spacecraft clock start.
    :return: Ephemeris time, seconds past J2000."""
    return _context().sct2e(sc, sclkdp)

def scte01(sc, sclkdp):
    """Convert encoded type 1 spacecraft clock (`ticks') to ephemeris seconds past J2000 (ET).
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/scte01.html
    
    :param sc: NAIF spacecraft ID code.
    :param sclkdp: Type 1 SCLK, encoded as ticks since clock start.
    :return: Ephemeris time, seconds past J2000. (PEPPER: an output; SPICELIB's table said I)"""
    return _context().scte01(sc, sclkdp)

def sctiks(sc, clkstr):
    """Convert a spacecraft clock format string to number of 'ticks'.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/sctiks.html
    
    :param sc: NAIF spacecraft identification code.
    :param clkstr: Character representation of a spacecraft clock.
    :return: Number of ticks represented by the clock string."""
    return _context().sctiks(sc, clkstr)

def sctk01(sc, clkstr):
    """Convert a character representation of a type 1 spacecraft clock count to ticks.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/sctk01.html
    
    :param sc: NAIF spacecraft ID code.
    :param clkstr: Character representation of a clock count.
    :return: Number of ticks represented by the clock count."""
    return _context().sctk01(sc, clkstr)

def scty01(sc):
    """Return the type of a specified clock. The clock need not be type 1.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/scty01.html
    
    :param sc: NAIF spacecraft clock ID code.
    :return: NAIF spacecraft clock type."""
    return _context().scty01(sc)

def sctype(sc):
    """Return the spacecraft clock type for a specified spacecraft.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/sctype.html
    
    :param sc: NAIF spacecraft ID code.
    :return: the result"""
    return _context().sctype(sc)

def sdiffd(a, b, c=None):
    """Take the symmetric difference of two double precision sets to form a third set.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/sdiffd.html
    
    :param a: First input set.
    :param b: Second input set.
    :param c: Symmetric difference of A and B.
    :return: Symmetric difference of A and B."""
    return _context().sdiffd(a, b, c)

def sdiffi(a, b, c=None):
    """Take the symmetric difference of two integer sets to form a third set.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/sdiffi.html
    
    :param a: First input set.
    :param b: Second input set.
    :param c: Symmetric difference of A and B.
    :return: Symmetric difference of A and B."""
    return _context().sdiffi(a, b, c)

def sepool(item, fidx, contin):
    """Retrieve the string starting at the FIDX element of the kernel pool variable, where the string may be continued across several components of the kernel pool variable.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/sepool.html
    
    :param item: name of the kernel pool variable
    :param fidx: index of the first component of the string
    :param contin: character sequence used to indicate continuation
    :return: a full string concatenated across continuations; the number of character in the full string value; index of the last component of the string
        (found: NotFoundError if not found, or the flag returned last with no_found_check)"""
    return _context().sepool(item, fidx, contin)

def setd(a, op, b):
    """Compare two double precision sets, as indicated by a relational operator.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/setd.html
    
    :param a: First set.
    :param op: Comparison operator.
    :param b: Second set.
    :return: the result"""
    return _context().setd(a, op, b)

def seti(a, op, b):
    """Compare two integer sets, as indicated by a relational operator.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/seti.html
    
    :param a: First set.
    :param op: Comparison operator.
    :param b: Second set.
    :return: the result"""
    return _context().seti(a, op, b)

def sgbwfs(handle, descr, segid, nconst, const_, pktsiz, idxtyp):
    """Begin writing a generic segment that will contain fixed size data packets.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/sgbwfs.html
    
    :param handle: Handle of a DAF file opened with write access.
    :param descr: Descriptor for a generic segment.
    :param segid: Identifier for a generic segment.
    :param nconst: Number of constant values in a generic segment.
    :param const_: Array of constant values for a generic segment.
    :param pktsiz: Size of the data packets.
    :param idxtyp: Index type for the reference values."""
    return _context().sgbwfs(handle, descr, segid, nconst, const_, pktsiz, idxtyp)

def sgbwvs(handle, descr, segid, nconst, const_, idxtyp):
    """Begin writing a generic segment that will contain variable size data packets.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/sgbwvs.html
    
    :param handle: Handle of a DAF file opened with write access.
    :param descr: Descriptor for a segment.
    :param segid: Identifier for a segment.
    :param nconst: Number of constant values in a segment.
    :param const_: Array of constant values for a segment.
    :param idxtyp: Index type for the reference values."""
    return _context().sgbwvs(handle, descr, segid, nconst, const_, idxtyp)

def sgfrvi(handle, descr, x):
    """Find the reference value associated with the value X and its index in a generic segment. The segment is identified by a DAF file handle and segment descriptor.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/sgfrvi.html
    
    :param handle: The handle of a DAF open for reading.
    :param descr: The descriptor for a DAF generic segment.
    :param x: The key value used to find a reference and index.
    :return: The reference value associated with X.; The index of VALUE within the reference values.
        (found: NotFoundError if not found, or the flag returned last with no_found_check)"""
    return _context().sgfrvi(handle, descr, x)

def sgmeta(handle, descr, mnemon):
    """Obtain the value of a specified generic segment meta data item.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/sgmeta.html
    
    :param handle: Handle of a DAF open for reading.
    :param descr: Descriptor for a generic segment in the DAF.
    :param mnemon: An integer mnemonic for the desired meta data.
    :return: The value of the meta data item requested."""
    return _context().sgmeta(handle, descr, mnemon)

def sgwes(handle):
    """End the generic segment in the DAF file associated with HANDLE.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/sgwes.html
    
    :param handle: Handle of a DAF file opened with write access."""
    return _context().sgwes(handle)

def sgwfpk(handle, npkts, pktdat, nrefs, refdat):
    """Write one or more fixed size data packets to the generic segment currently being written to the DAF file associated with HANDLE.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/sgwfpk.html
    
    :param handle: Handle of a DAF file opened with write access.
    :param npkts: Number of data packets to write to a segment.
    :param pktdat: Array of packet data.
    :param nrefs: Number of reference values.
    :param refdat: Reference data."""
    return _context().sgwfpk(handle, npkts, pktdat, nrefs, refdat)

def sgwvpk(handle, npkts, pktsiz, pktdat, nrefs, refdat):
    """Write one or more variable size data packets to the generic segment currently being written to the DAF file associated with HANDLE.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/sgwvpk.html
    
    :param handle: Handle of a DAF file opened with write access.
    :param npkts: Number of data packets to write to a segment.
    :param pktsiz: Array of sizes of variable size packets.
    :param pktdat: Array of packet data.
    :param nrefs: Number of reference values.
    :param refdat: Reference data."""
    return _context().sgwvpk(handle, npkts, pktsiz, pktdat, nrefs, refdat)

def shiftc(in_, dir, nshift, fillc):
    """Shift the contents of a character string to the left or right. Characters moved past the beginning or end of the string are lost. Vacant spaces are filled with a specified character.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/shiftc.html
    
    :param in_: Input string.
    :param dir: Direction to shift.
    :param nshift: Number of times to shift.
    :param fillc: Character to fill spaces left vacant.
    :return: Shifted string."""
    return _context().shiftc(in_, dir, nshift, fillc)

def sincpt(method, target, et, fixref, abcorr, obsrvr, dref, dvec):
    """Compute, for a given observer and a ray emanating from the observer, the surface intercept of the ray on a target body at a specified epoch, optionally corrected for light time and stellar aberration.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/sincpt.html
    
    :param method: Computation method.
    :param target: Name of target body.
    :param et: Epoch in ephemeris seconds past J2000 TDB.
    :param fixref: Body-fixed, body-centered target body frame.
    :param abcorr: Aberration correction.
    :param obsrvr: Name of observing body.
    :param dref: Reference frame of ray's direction vector.
    :param dvec: Ray's direction vector.
    :return: Surface intercept point on the target body.; Intercept epoch.; Vector from observer to intercept point.
        (found: NotFoundError if not found, or the flag returned last with no_found_check)"""
    return _context().sincpt(method, target, et, fixref, abcorr, obsrvr, dref, dvec)

def sized(cell):
    """Return the size (maximum cardinality) of a double precision cell.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/sized.html
    
    :param cell: Input cell.
    :return: the result"""
    return _context().sized(cell)

def sizei(cell):
    """Return the size (maximum cardinality) of an integer cell.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/sizei.html
    
    :param cell: Input cell.
    :return: the result"""
    return _context().sizei(cell)

def spca2b(text, binary):
    """Convert a text (ASCII) format SPK or CK file to an equivalent binary file, including comments.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/spca2b.html
    
    :param text: Name of an existing text format SPK or CK file.
    :param binary: Name of a binary SPK or CK file to be created."""
    return _context().spca2b(text, binary)

def spcac(handle, unit, bmark, emark):
    """Store text from a text file in the comment area of a binary SPK or CK file, appending it to whatever text may already have been stored there.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/spcac.html
    
    :param handle: Handle assigned to binary SPK or CK file.
    :param unit: Logical unit connected to comment file.
    :param bmark: Beginning marker.
    :param emark: Ending marker."""
    return _context().spcac(handle, unit, bmark, emark)

def spcb2a(binary, text):
    """Convert a binary SPK or CK file to an equivalent text (ASCII) file, including the comment area.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/spcb2a.html
    
    :param binary: Name of an existing binary SPK or CK file.
    :param text: Name of a text file to be created."""
    return _context().spcb2a(binary, text)

def spcb2t(binary, unit):
    """Convert the contents of a binary SPK or CK file to text, including comments if present, and write them to a text file opened by the calling program.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/spcb2t.html
    
    :param binary: Name of an existing binary SPK or CK file.
    :param unit: Logical unit connected to a text file."""
    return _context().spcb2t(binary, unit)

def spcdc(handle):
    """Empty the comment area of a binary SPK or CK file.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/spcdc.html
    
    :param handle: Handle assigned to binary SPK or CK file."""
    return _context().spcdc(handle)

def spcec(handle, unit):
    """Extract the text from the comment area of a binary SPK or CK file and write it to a text file.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/spcec.html
    
    :param handle: Handle assigned to binary SPK or CK file.
    :param unit: Logical unit connected to text file."""
    return _context().spcec(handle, unit)

def spcopn(fname, ifname):
    """Open a new SPK or CK file for subsequent write requests.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/spcopn.html
    
    :param fname: Name of SPK or CK file to be created.
    :param ifname: Internal file name.
    :return: Handle of new SPK or CK file."""
    return _context().spcopn(fname, ifname)

def spcrfl(handle):
    """Read the first line of text from the comment area of a binary SPK or CK file.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/spcrfl.html
    
    :param handle: Handle assigned to binary SPK or CK file.
    :return: First line of text from the comment area.; End of comments?"""
    return _context().spcrfl(handle)

def spcrnl():
    """Continue reading lines from the comment area of a binary SPK or CK file specified by the most recent call to the routine `spcrfl`.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/spcrnl.html
    
    :return: Next line of text from the comment area.; End of comments?"""
    return _context().spcrnl()

def spct2b(unit, binary):
    """Reconstruct a binary SPK or CK file including comments from a text file opened by the calling program.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/spct2b.html
    
    :param unit: Logical unit connected to the text format file.
    :param binary: Name of a binary SPK or CK file to be created."""
    return _context().spct2b(unit, binary)

def sphsd(radius, lon1, lat1, lon2, lat2):
    """Return the distance between two points on a sphere, measured along the shortest great circle arc connecting them.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/sphsd.html
    
    :param radius: Radius of sphere.
    :param lon1: Longitude and latitude of first point in radians.
    :param lat1: Longitude and latitude of first point in radians.
    :param lon2: Longitude and latitude of second point in radians.
    :param lat2: Longitude and latitude of second point in radians.
    :return: the result"""
    return _context().sphsd(radius, lon1, lat1, lon2, lat2)

def spk14a(handle, ncsets, coeffs, epochs):
    """Add data to a type 14 SPK segment associated with HANDLE.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/spk14a.html
    
    :param handle: The handle of an SPK file open for writing.
    :param ncsets: The number of coefficient sets and epochs.
    :param coeffs: The collection of coefficient sets.
    :param epochs: The epochs associated with the coefficient sets."""
    return _context().spk14a(handle, ncsets, coeffs, epochs)

def spk14b(handle, segid, body, center, framename, first, last, chbdeg):
    """Begin a type 14 SPK segment in the SPK file associated with HANDLE.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/spk14b.html
    
    :param handle: The handle of an SPK file open for writing.
    :param segid: The string to use for segment identifier.
    :param body: The NAIF ID code for the body of the segment.
    :param center: The center of motion for BODY.
    :param framename: The reference frame for this segment.
    :param first: The first epoch for which the segment is valid.
    :param last: The last epoch for which the segment is valid.
    :param chbdeg: The degree of the Chebyshev Polynomial used."""
    return _context().spk14b(handle, segid, body, center, framename, first, last, chbdeg)

def spk14e(handle):
    """End the type 14 SPK segment currently being written to the SPK file associated with HANDLE.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/spk14e.html
    
    :param handle: The handle of an SPK file open for writing."""
    return _context().spk14e(handle)

def spk_coverage(file, body):
    """The coverage of an object in an SPK file (PEPPER; `spkcov` without a window cell).
    
    :param file: the SPK file
    :param body: the NAIF ID code of the object
    :return: the coverage, shape (2, n) (n = 0 after an error)"""
    return _context().spk_coverage(file, body)

def spk_objects(file):
    """The objects of an SPK file (PEPPER; `spkobj` without a set cell): their ID codes, sorted, without duplicates.
    
    :param file: the SPK file
    :return: the ID codes (size 0 after an error)"""
    return _context().spk_objects(file)

def spkacs(targ, et, ref, abcorr, obs):
    """Return the state (position and velocity) of a target body relative to an observer, optionally corrected for light time and stellar aberration, expressed relative to an inertial reference frame.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/spkacs.html
    
    :param targ: Target body.
    :param et: Observer epoch.
    :param ref: Inertial reference frame of output state.
    :param abcorr: Aberration correction flag.
    :param obs: Observer.
    :return: State of target.; One way light time between observer and target.; Derivative of light time with respect to time."""
    return _context().spkacs(targ, et, ref, abcorr, obs)

def spkapo(targ, et, ref, sobs, abcorr):
    """Return the position of a target body relative to an observer, optionally corrected for light time and stellar aberration.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/spkapo.html
    
    :param targ: Target body.
    :param et: Observer epoch.
    :param ref: Inertial reference frame of observer's state.
    :param sobs: State of observer wrt. solar system barycenter.
    :param abcorr: Aberration correction flag.
    :return: Position of target.; One way light time between observer and target."""
    return _context().spkapo(targ, et, ref, sobs, abcorr)

def spkapp(targ, et, ref, sobs, abcorr):
    """**Deprecated:** This routine has been superseded by the SPICELIB routine `spkaps`. This routine is supported for purposes of backward compatibility only.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/spkapp.html
    
    :param targ: Target body.
    :param et: Observer epoch.
    :param ref: Inertial reference frame of observer's state.
    :param sobs: State of observer wrt. solar system barycenter.
    :param abcorr: Aberration correction flag.
    :return: State of target.; One way light time between observer and target."""
    return _context().spkapp(targ, et, ref, sobs, abcorr)

def spkaps(targ, et, ref, abcorr, stobs, accobs):
    """Return the state (position and velocity) of a target body relative to an observer specified by its state and acceleration relative to the solar system barycenter. The returned state may be optionally corrected for light time and stellar aberration. All input and output vectors are expressed relative to an inertial reference frame.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/spkaps.html
    
    :param targ: Target body.
    :param et: Observer epoch.
    :param ref: Inertial reference frame of output state.
    :param abcorr: Aberration correction flag.
    :param stobs: State of the observer relative to the SSB.
    :param accobs: Acceleration of the observer relative to the SSB.
    :return: State of target.; One way light time between observer and target.; Derivative of light time with respect to time."""
    return _context().spkaps(targ, et, ref, abcorr, stobs, accobs)

def spkcls(handle):
    """Close an open SPK file.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/spkcls.html
    
    :param handle: Handle of the SPK file to be closed."""
    return _context().spkcls(handle)

def spkcov(spk, idcode, cover=None):
    """Find the coverage window for a specified ephemeris object in a specified SPK file.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/spkcov.html
    
    :param spk: Name of SPK file.
    :param idcode: ID code of ephemeris object.
    :param cover: Window giving coverage in SPKFNM for IDCODE.
    :return: Window giving coverage in SPKFNM for IDCODE."""
    return _context().spkcov(spk, idcode, cover)

def spkcpo(target, et, outref, refloc, abcorr, obspos, obsctr, obsref):
    """Return the state of a specified target relative to an 'observer,' where the observer has constant position in a specified reference frame. The observer's position is provided by the calling program rather than by loaded SPK files.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/spkcpo.html
    
    :param target: Name of target ephemeris object.
    :param et: Observation epoch.
    :param outref: Reference frame of output state.
    :param refloc: Output reference frame evaluation locus.
    :param abcorr: Aberration correction.
    :param obspos: Observer position relative to center of motion.
    :param obsctr: Center of motion of observer.
    :param obsref: Frame of observer position.
    :return: State of target with respect to observer.; One way light time between target and observer."""
    return _context().spkcpo(target, et, outref, refloc, abcorr, obspos, obsctr, obsref)

def spkcpt(trgpos, trgctr, trgref, et, outref, refloc, abcorr, obsrvr):
    """Return the state, relative to a specified observer, of a target having constant position in a specified reference frame. The target's position is provided by the calling program rather than by loaded SPK files.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/spkcpt.html
    
    :param trgpos: Target position relative to center of motion.
    :param trgctr: Center of motion of target.
    :param trgref: Frame of target position.
    :param et: Observation epoch.
    :param outref: Reference frame of output state.
    :param refloc: Output reference frame evaluation locus.
    :param abcorr: Aberration correction.
    :param obsrvr: Name of observing ephemeris object.
    :return: State of target with respect to observer.; One way light time between target and observer."""
    return _context().spkcpt(trgpos, trgctr, trgref, et, outref, refloc, abcorr, obsrvr)

def spkcvo(target, et, outref, refloc, abcorr, obssta, obsepc, obsctr, obsref):
    """Return the state of a specified target relative to an 'observer,' where the observer has constant velocity in a specified reference frame. The observer's state is provided by the calling program rather than by loaded SPK files.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/spkcvo.html
    
    :param target: Name of target ephemeris object.
    :param et: Observation epoch.
    :param outref: Reference frame of output state.
    :param refloc: Output reference frame evaluation locus.
    :param abcorr: Aberration correction.
    :param obssta: Observer state relative to center of motion.
    :param obsepc: Epoch of observer state.
    :param obsctr: Center of motion of observer.
    :param obsref: Frame of observer state.
    :return: State of target with respect to observer.; One way light time between target and observer."""
    return _context().spkcvo(target, et, outref, refloc, abcorr, obssta, obsepc, obsctr, obsref)

def spkcvt(trgsta, trgepc, trgctr, trgref, et, outref, refloc, abcorr, obsrvr):
    """Return the state, relative to a specified observer, of a target having constant velocity in a specified reference frame. The target's state is provided by the calling program rather than by loaded SPK files.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/spkcvt.html
    
    :param trgsta: Target state relative to center of motion.
    :param trgepc: Epoch of target state.
    :param trgctr: Center of motion of target.
    :param trgref: Frame of target state.
    :param et: Observation epoch.
    :param outref: Reference frame of output state.
    :param refloc: Output reference frame evaluation locus.
    :param abcorr: Aberration correction.
    :param obsrvr: Name of observing ephemeris object.
    :return: State of target with respect to observer.; One way light time between target and observer."""
    return _context().spkcvt(trgsta, trgepc, trgctr, trgref, et, outref, refloc, abcorr, obsrvr)

def spke01(et, record):
    """Evaluate a single SPK data record from a segment of type 1 (Difference Lines).
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/spke01.html
    
    :param et: Target epoch.
    :param record: Data record.
    :return: State (position and velocity)."""
    return _context().spke01(et, record)

def spke02(et, record):
    """Evaluate a single data record from an PCK or SPK segment of type 2 (Chebyshev Polynomials, 3 components).
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/spke02.html
    
    :param et: Evaluation epoch.
    :param record: Data record.
    :return: Three function components and their derivatives."""
    return _context().spke02(et, record)

def spke03(et, record):
    """Evaluate a single SPK data record from a segment of type 3 (Chebyshev Polynomials, position and velocity).
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/spke03.html
    
    :param et: Evaluation epoch.
    :param record: Data record.
    :return: State (position and velocity)."""
    return _context().spke03(et, record)

def spke05(et, record):
    """Evaluate a single SPK data record from a segment of type 5 (two body propagation between discrete state vectors).
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/spke05.html
    
    :param et: Target epoch.
    :param record: Data record.
    :return: State (position and velocity)."""
    return _context().spke05(et, record)

def spke08(et, record):
    """Evaluate a single SPK data record from a segment of type 8 (equally spaced discrete states, interpolated by Lagrange polynomials).
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/spke08.html
    
    :param et: Target epoch.
    :param record: Data record.
    :return: State (position and velocity)."""
    return _context().spke08(et, record)

def spke09(et, record):
    """Evaluate a single SPK data record from a segment of type 9 (discrete states, evaluated by Lagrange interpolation).
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/spke09.html
    
    :param et: Target epoch.
    :param record: Data record.
    :return: Data record.; State (position and velocity)."""
    return _context().spke09(et, record)

def spke10(et, record):
    """Evaluate a single SPK data record from a segment of type 10 (NORAD two-line element sets.). This evaluator uses algorithms as described in Vallado 2006 [4].
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/spke10.html
    
    :param et: Target epoch.
    :param record: Data record.
