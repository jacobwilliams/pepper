    return _context().spkw17(handle, body, center, inframe, first, last, segid, epoch, eqel, rapol, decpol)

def spkw18(handle, subtyp, body, center, inframe, first, last, segid, degree, packts, epochs):
    """Write a type 18 segment to an SPK file.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/spkw18.html
    
