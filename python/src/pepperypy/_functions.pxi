    cdef cnp.ndarray _a_array = _rows(np.array(array, dtype=np.float64 if NPY_DOUBLE == NPY_DOUBLE else np.int32), NPY_DOUBLE, 1)
    pepper_shelld(_c_ndim, <double*>cnp.PyArray_DATA(_a_array))
    return _a_array

