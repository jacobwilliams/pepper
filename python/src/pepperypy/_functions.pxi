def brcktd(number, end1, end2):
    """Bracket a double precision number. That is, given a number and an acceptable interval, make sure that the number is contained in the interval. (If the number is already in the interval, leave it alone. If not, set it to the nearest endpoint of the interval.)
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/brcktd.html
    
    :param number: Number to be bracketed.
    :param end1: One of the bracketing endpoints for NUMBER.
    :param end2: The other bracketing endpoint for NUMBER.
    :return: the result"""
    cdef double _c_number = number
    cdef double _c_end1 = end1
    cdef double _c_end2 = end2
    cdef double _c_fresult = 0
    cdef int _st = 0
    pepper_brcktd(_c_number, _c_end1, _c_end2, &_c_fresult)
    return _c_fresult

def brckti(number, end1, end2):
    """Bracket an integer number. That is, given a number and an acceptable interval, make sure that the number is contained in the interval. (If the number is already in the interval, leave it alone. If not, set it to the nearest endpoint of the interval.)
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/brckti.html
    
    :param number: Number to be bracketed.
    :param end1: One of the bracketing endpoints for NUMBER.
    :param end2: The other bracketing endpoint for NUMBER.
    :return: the result"""
    cdef int _c_number = number
    cdef int _c_end1 = end1
    cdef int _c_end2 = end2
    cdef int _c_fresult = 0
    cdef int _st = 0
    pepper_brckti(_c_number, _c_end1, _c_end2, &_c_fresult)
    return _c_fresult

def bschoc(value, ndim, lenvals=None, array=None, order=None):
    """Do a binary search for a given value within an array of character strings, accompanied by an order vector. Return the index of the matching array entry, or zero if the key value is not found.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/bschoc.html
    
    :param value: Key value to be found in ARRAY.
    :param ndim: Dimension of ARRAY.
    :param lenvals: (SpiceyPy compatibility; ignored)
    :param array: Character string array to search.
    :param order: Order vector.
    :return: the result"""
    cdef int _c_ndim = ndim
    cdef int _c_fresult = 0
    cdef int _st = 0
    cdef bytes _b_value = _b(value)
    cdef bytes _b_array
