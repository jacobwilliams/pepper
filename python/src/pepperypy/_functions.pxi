    :param handle: HANDLE to be validated.
    :param access: String indicating access type."""
    return _context().dassih(handle, access)

def dastb(xfrlun, binfil):
    """Convert the contents of a DAS transfer file into an equivalent binary DAS file.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dastb.html
    
    :param xfrlun: Logical unit of an open DAS transfer file.
    :param binfil: Name of the binary DAS file to be created."""
    return _context().dastb(xfrlun, binfil)

def dasudc(handle, first, last, bpos, epos, data):
    """Update character data in a specified range of DAS logical addresses with substrings of a character array.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dasudc.html
    
    :param handle: DAS file handle.
    :param first: Range of DAS character logical addresses.
    :param last: Range of DAS character logical addresses.
    :param bpos: Begin and end positions of substrings.
    :param epos: Begin and end positions of substrings.
    :param data: Data having addresses FIRST through LAST."""
    return _context().dasudc(handle, first, last, bpos, epos, data)

def dasudd(handle, first, last, data):
    """Update data in a specified range of double precision addresses in a DAS file.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dasudd.html
    
    :param handle: DAS file handle.
    :param first: Range of d.p. addresses to write to.
    :param last: Range of d.p. addresses to write to.
    :param data: An array of d.p. numbers."""
    return _context().dasudd(handle, first, last, data)

def dasudi(handle, first, last, data):
    """Update data in a specified range of integer addresses in a DAS file.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dasudi.html
    
    :param handle: DAS file handle.
    :param first: Range of integer addresses to write to.
    :param last: Range of integer addresses to write to.
    :param data: An array of integers."""
    return _context().dasudi(handle, first, last, data)

def dasufs(handle, nresvr, nresvc, ncomr, ncomc, free, lastla, lastrc, lastwd):
    """Update the file summary in a specified DAS file.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dasufs.html
    
    :param handle: Handle of an open DAS file.
    :param nresvr: Number of reserved records in file.
    :param nresvc: Number of characters in use in reserved rec. area.
    :param ncomr: Number of comment records in file.
    :param ncomc: Number of characters in use in comment area.
    :param free: Number of first free record.
    :param lastla: Array of last logical addresses for each data
    :param lastrc: Record number of last descriptor of each data
    :param lastwd: Word number of last descriptor of each data"""
    return _context().dasufs(handle, nresvr, nresvc, ncomr, ncomc, free, lastla, lastrc, lastwd)

def dasurc(handle, recno, first, last, datac):
    """Update DAS character physical records.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dasurc.html
    
    :param handle: Handle of DAS file.
    :param recno: Record number.
    :param first: First and last indices of range within record.
    :param last: First and last indices of range within record.
    :param datac: Character data to write to record."""
    return _context().dasurc(handle, recno, first, last, datac)

def dasurd(handle, recno, first, last, datad):
    """Update DAS double precision physical records.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dasurd.html
    
    :param handle: Handle of DAS file.
    :param recno: Record number.
    :param first: First and last indices of range within record.
    :param last: First and last indices of range within record.
    :param datad: Double precision data to write to record."""
    return _context().dasurd(handle, recno, first, last, datad)

def dasuri(handle, recno, first, last, datai):
    """Update DAS integer physical records.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dasuri.html
    
    :param handle: Handle of DAS file.
    :param recno: Record number.
    :param first: First and last indices of range within record.
    :param last: First and last indices of range within record.
    :param datai: Integer data to write to record."""
    return _context().dasuri(handle, recno, first, last, datai)

def daswbr(handle):
    """Write out all buffered records of a specified DAS file.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/daswbr.html
    
    :param handle: Handle of DAS file."""
    return _context().daswbr(handle)

def daswfr(handle, idword, ifname, nresvr, nresvc, ncomr, ncomc):
    """Update the contents of the file record of a specified DAS file.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/daswfr.html
    
    :param handle: DAS file handle.
    :param idword: ID word.
    :param ifname: DAS internal file name.
    :param nresvr: Number of reserved records in file.
    :param nresvc: Number of characters in use in reserved rec. area.
    :param ncomr: Number of comment records in file.
    :param ncomc: Number of characters in use in comment area."""
    return _context().daswfr(handle, idword, ifname, nresvr, nresvc, ncomr, ncomc)

def daswrc(handle, recno, recc):
    """Write DAS character physical records.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/daswrc.html
    
    :param handle: Handle of DAS file.
    :param recno: Record number.
    :param recc: Character data to be written to record."""
    return _context().daswrc(handle, recno, recc)

def datanh(x):
    """Return the inverse hyperbolic tangent of a double precision argument.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/datanh.html
    
    :param x: Number whose inverse hyperbolic tangent is desired.
    :return: the result"""
    return _context().datanh(x)

def dazldr(x, y, z, azccw, elplsz):
    """Compute the Jacobian matrix of the transformation from rectangular to azimuth/elevation coordinates.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dazldr.html
    
    :param x: X-coordinate of point.
    :param y: Y-coordinate of point.
    :param z: Z-coordinate of point.
    :param azccw: Flag indicating how azimuth is measured.
    :param elplsz: Flag indicating how elevation is measured.
    :return: Matrix of partial derivatives."""
    return _context().dazldr(x, y, z, azccw, elplsz)

def dcyldr(x, y, z):
    """Compute the Jacobian matrix of the transformation from rectangular to cylindrical coordinates.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dcyldr.html
    
    :param x: X-coordinate of point.
    :param y: Y-coordinate of point.
    :param z: Z-coordinate of point.
    :return: Matrix of partial derivatives."""
    return _context().dcyldr(x, y, z)

def dechar(string):
    """Decode a character string encoded by `enchar`.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dechar.html
    
    :param string: Encoded character string.
    :return: Decoded number."""
    return _context().dechar(string)

def delfil(filnam):
    """Delete a file.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/delfil.html
    
    :param filnam: The name of a file to be deleted."""
    return _context().delfil(filnam)

def deltet(epoch, eptype):
    """Return the value of Delta ET (ET-UTC) for an input epoch.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/deltet.html
    
    :param epoch: Input epoch (seconds past J2000).
    :param eptype: Type of input epoch ('UTC' or 'ET').
    :return: Delta ET (ET-UTC) at input epoch."""
    return _context().deltet(epoch, eptype)

def dgeodr(x, y, z, re, f):
    """Compute the Jacobian matrix of the transformation from rectangular to geodetic coordinates.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dgeodr.html
    
    :param x: X-coordinate of point.
    :param y: Y-coordinate of point.
    :param z: Z-coordinate of point.
    :param re: Equatorial radius of the reference spheroid.
    :param f: Flattening coefficient.
    :return: Matrix of partial derivatives."""
    return _context().dgeodr(x, y, z, re, f)

def dhfa(state, bodyr):
    """Calculate the value of the time derivative of the half angle of a spherical body given a state vector STATE and body radius BODYR.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dhfa.html
    
    :param state: SPICE state vector
    :param bodyr: Radius of body
    :return: the result"""
    return _context().dhfa(state, bodyr)

def diags2(symmat):
    """Diagonalize a symmetric 2x2 matrix.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/diags2.html
    
    :param symmat: A symmetric 2x2 matrix.
    :return: A diagonal matrix similar to SYMMAT.; A rotation used as the similarity transformation."""
    return _context().diags2(symmat)

def diffd(a, b, c=None):
    """Take the difference of two double precision sets to form a third set.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/diffd.html
    
    :param a: First input set.
    :param b: Second input set.
    :param c: Difference of A and B.
    :return: Difference of A and B."""
    return _context().diffd(a, b, c)

def diffi(a, b, c=None):
    """Take the difference of two integer sets to form a third set.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/diffi.html
    
    :param a: First input set.
    :param b: Second input set.
    :param c: Difference of A and B.
    :return: Difference of A and B."""
    return _context().diffi(a, b, c)

def dlabbs(handle):
    """Begin a backward segment search in a DLA file.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dlabbs.html
    
    :param handle: Handle of open DLA file.
    :return: Descriptor of last segment in DLA file.
        (found: NotFoundError if not found, or the flag returned last with no_found_check)"""
    return _context().dlabbs(handle)

def dlabfs(handle):
    """Begin a forward segment search in a DLA file.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dlabfs.html
    
    :param handle: Handle of open DLA file.
    :return: Descriptor of first segment in DLA file.
        (found: NotFoundError if not found, or the flag returned last with no_found_check)"""
    return _context().dlabfs(handle)

def dlabns(handle):
    """Begin a new segment in a DLA file.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dlabns.html
    
    :param handle: Handle of open DLA file."""
    return _context().dlabns(handle)

def dlaens(handle):
    """End a new segment in a DLA file.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dlaens.html
    
    :param handle: Handle of open DLA file."""
    return _context().dlaens(handle)

def dlafns(handle, descr):
    """Find the segment following a specified segment in a DLA file.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dlafns.html
    
    :param handle: Handle of open DLA file.
    :param descr: Descriptor of a segment in DLA file.
    :return: Descriptor of next segment in DLA file.
        (found: NotFoundError if not found, or the flag returned last with no_found_check)"""
    return _context().dlafns(handle, descr)

def dlafps(handle, descr):
    """Find the segment preceding a specified segment in a DLA file.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dlafps.html
    
    :param handle: Handle of open DLA file.
    :param descr: Descriptor of a segment in DLA file.
    :return: Descriptor of previous segment in DLA file.
        (found: NotFoundError if not found, or the flag returned last with no_found_check)"""
    return _context().dlafps(handle, descr)

def dlaopn(fname, ftype, ifname, ncomch):
    """Open a new DLA file and set the file type.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dlaopn.html
    
    :param fname: Name of a DLA file to be opened.
    :param ftype: Mnemonic code for type of data in the DLA file.
    :param ifname: Internal file name.
    :param ncomch: Number of comment characters to allocate.
    :return: Handle assigned to the opened DLA file."""
    return _context().dlaopn(fname, ftype, ifname, ncomch)

def dlatdr(x, y, z):
    """Compute the Jacobian matrix of the transformation from rectangular to latitudinal coordinates.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dlatdr.html
    
    :param x: X-coordinate of point.
    :param y: Y-coordinate of point.
    :param z: Z-coordinate of point.
    :return: Matrix of partial derivatives."""
    return _context().dlatdr(x, y, z)

def dnearp(state, a, b, c):
    """Compute the state (position and velocity) of an ellipsoid surface point nearest to the position component of a specified state.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dnearp.html
    
    :param state: State of an object in body-fixed coordinates.
    :param a: Length of semi-axis parallel to X-axis.
    :param b: Length of semi-axis parallel to Y-axis.
    :param c: Length on semi-axis parallel to Z-axis.
    :return: State of the nearest point on the ellipsoid.; Altitude and derivative of altitude.
        (found: NotFoundError if not found, or the flag returned last with no_found_check)"""
    return _context().dnearp(state, a, b, c)

def dp2hx(number, lenout=None):
    """Convert a double precision number to an equivalent character string using a base 16 'scientific notation.'
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dp2hx.html
    
    :param number: D.p. number to be converted.
    :param lenout: (SpiceyPy compatibility; ignored)
    :return: Equivalent character string, left justified.; Length of the character string produced."""
    return _context().dp2hx(number, lenout)

def dpfmt(x, pictur):
    """Create a formatted string that represents a double precision number, using a format picture.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dpfmt.html
    
    :param x: a double precision number.
    :param pictur: a string describing the appearance of the output
    :return: a string representing X as prescribed by PICTUR"""
    return _context().dpfmt(x, pictur)

def dpgrdr(body, x, y, z, re, f):
    """Compute the Jacobian matrix of the transformation from rectangular to planetographic coordinates.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dpgrdr.html
    
    :param body: Body with which coordinate system is associated.
    :param x: X-coordinate of point.
    :param y: Y-coordinate of point.
    :param z: Z-coordinate of point.
    :param re: Equatorial radius of the reference spheroid.
    :param f: Flattening coefficient.
    :return: Matrix of partial derivatives."""
    return _context().dpgrdr(body, x, y, z, re, f)

def dpspce(et, geophs, elems):
    """**Deprecated:** This routine has been superseded by the SPICELIB routine `evsgp4`. *ALL* TLE evaluations should use that routine. NAIF supports `dpspce` only for backward compatibility.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dpspce.html
    
    :param et: Time for state evaluation in seconds past ephemeris epoch J2000.
    :param geophs: The array of geophysical constants.
    :param elems: Array of orbit elements.
    :return: State vector at ET."""
    return _context().dpspce(et, geophs, elems)

def dpstrf(x, sigdig, format):
    """Take a double precision number and convert it to an equivalent formatted character string representation (base 10).
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dpstrf.html
    
    :param x: A double precision number
    :param sigdig: The number of significant digits saved for output
    :param format: 'E' for scientific, 'F' for floating point.
    :return: A character string representation of X"""
    return _context().dpstrf(x, sigdig, format)

def drdazl(inrange, az, el, azccw, elplsz):
    """Compute the Jacobian matrix of the transformation from azimuth/elevation to rectangular coordinates.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/drdazl.html
    
    :param inrange: Distance of a point from the origin.
    :param az: Azimuth of input point in radians.
    :param el: Elevation of input point in radians.
    :param azccw: Flag indicating how azimuth is measured.
    :param elplsz: Flag indicating how elevation is measured.
    :return: Matrix of partial derivatives."""
    return _context().drdazl(inrange, az, el, azccw, elplsz)

def drdgeo(lon, lat, alt, re, f):
    """Compute the Jacobian matrix of the transformation from geodetic to rectangular coordinates.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/drdgeo.html
    
    :param lon: Geodetic longitude of point (radians).
    :param lat: Geodetic latitude of point (radians).
    :param alt: Altitude of point above the reference spheroid.
    :param re: Equatorial radius of the reference spheroid.
    :param f: Flattening coefficient.
    :return: Matrix of partial derivatives."""
    return _context().drdgeo(lon, lat, alt, re, f)

def drdpgr(body, lon, lat, alt, re, f):
    """Compute the Jacobian matrix of the transformation from planetographic to rectangular coordinates.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/drdpgr.html
    
    :param body: Name of body with which coordinates are associated.
    :param lon: Planetographic longitude of a point (radians).
    :param lat: Planetographic latitude of a point (radians).
    :param alt: Altitude of a point above reference spheroid.
    :param re: Equatorial radius of the reference spheroid.
    :param f: Flattening coefficient.
    :return: Matrix of partial derivatives."""
    return _context().drdpgr(body, lon, lat, alt, re, f)

def drotat(angle, iaxis):
    """Calculate the derivative with respect to the angle of rotation of a 3x3 coordinate system rotation matrix generated by a rotation of a specified angle about a specified axis.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/drotat.html
    
    :param angle: Angle of rotation (radians).
    :param iaxis: Coordinate axis number (X=1, Y=2, Z=3).
    :return: Derivative of rotation matrix [ANGLE] w.r.t. angle IAXIS"""
    return _context().drotat(angle, iaxis)

def dsk_objects(file):
    """The bodies of a DSK file (PEPPER; `dskobj` without a set cell): their ID codes, sorted, without duplicates.
    
    :param file: the DSK file
    :return: the body ID codes (size 0 after an error)"""
    return _context().dsk_objects(file)

def dsk_plates(handle, dladsc):
    """All the plates of a type 2 DSK segment (PEPPER; `dskp02` with the size from `dskz02`).
    
    :param handle: the handle of the DSK file
    :param dladsc: the DLA descriptor of the segment
    :return: the plates, shape (3, n): vertex indices (n = 0 after an error)"""
    return _context().dsk_plates(handle, dladsc)

def dsk_surfaces(file, body):
    """The surfaces of a body in a DSK file (PEPPER; `dsksrf` without a set cell): their ID codes, sorted, without duplicates.
    
    :param file: the DSK file
    :param body: the body ID code
    :return: the surface ID codes (size 0 after an error)"""
    return _context().dsk_surfaces(file, body)

def dsk_vertices(handle, dladsc):
    """All the vertices of a type 2 DSK segment (PEPPER; `dskv02` with the size from `dskz02`).
    
    :param handle: the handle of the DSK file
    :param dladsc: the DLA descriptor of the segment
    :return: the vertices, shape (3, n) (n = 0 after an error)"""
    return _context().dsk_vertices(handle, dladsc)

def dskb02(handle, dladsc):
    """Return bookkeeping data from a DSK type 2 segment.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dskb02.html
    
    :param handle: DSK file handle.
    :param dladsc: DLA descriptor.
    :return: Number of vertices in model.; Number of plates in model.; Number of voxels in fine grid.; Vertex bounds.; Fine voxel edge length.; Fine voxel grid origin.; Fine voxel grid extent.; Coarse voxel grid scale.; Size of vertex-plate correspondence list.; Size of voxel-plate pointer list.; Size of voxel-plate correspondence list."""
    return _context().dskb02(handle, dladsc)

def dskcls(handle, optmiz=False):
    """Close a DSK file.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dskcls.html
    
    :param handle: Handle assigned to the opened DSK file.
    :param optmiz: Flag indicating whether to segregate the DSK."""
    return _context().dskcls(handle, optmiz)

def dskd02(handle, dladsc, item, start, room):
    """Fetch double precision data from a type 2 DSK segment.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dskd02.html
    
    :param handle: DSK file handle.
    :param dladsc: DLA descriptor.
    :param item: Keyword identifying item to fetch.
    :param start: Start index.
    :param room: Amount of room in output array.
    :return: Number of values returned.; Array containing requested item."""
    return _context().dskd02(handle, dladsc, item, start, room)

def dskgd(handle, dladsc):
    """Return the DSK descriptor from a DSK segment identified by a DAS handle and DLA descriptor.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dskgd.html
    
    :param handle: Handle of a DSK file.
    :param dladsc: DLA segment descriptor.
    :return: DSK segment descriptor."""
    return _context().dskgd(handle, dladsc)

def dskgtl(keywrd):
    """Retrieve the value of a specified DSK tolerance or margin parameter.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dskgtl.html
    
    :param keywrd: Code specifying parameter to retrieve.
    :return: Value of parameter."""
    return _context().dskgtl(keywrd)

def dski02(handle, dladsc, item, start, room):
    """Fetch integer data from a type 2 DSK segment.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dski02.html
    
    :param handle: DSK file handle.
    :param dladsc: DLA descriptor.
    :param item: Keyword identifying item to fetch.
    :param start: Start index.
    :param room: Amount of room in output array.
    :return: Number of values returned.; Array containing requested item."""
    return _context().dski02(handle, dladsc, item, start, room)

def dskmi2(vrtces, plates, finscl, corscl, worksz, voxpsz, voxlsz, makvtl, spxisz):
    """Make spatial index for a DSK type 2 segment. The index is returned as a pair of arrays, one of type INTEGER and one of type DOUBLE PRECISION. These arrays are suitable for use with the DSK type 2 writer `dskw02`.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dskmi2.html
    
    :param vrtces: Vertices.
    :param plates: Plates.
    :param finscl: Fine voxel scale.
    :param corscl: Coarse voxel scale.
    :param worksz: Workspace size.
    :param voxpsz: Voxel-plate pointer array size.
    :param voxlsz: Voxel-plate list array size.
    :param makvtl: Vertex-plate list flag.
    :param spxisz: Spatial index integer component size.
    :return: Double precision component of spatial index.; Integer component of spatial index."""
    return _context().dskmi2(vrtces, plates, finscl, corscl, worksz, voxpsz, voxlsz, makvtl, spxisz)

def dskn02(handle, dladsc, plid):
    """Compute the unit normal vector for a specified plate from a type 2 DSK segment.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dskn02.html
    
    :param handle: DSK file handle.
    :param dladsc: DLA descriptor.
    :param plid: Plate ID.
    :return: Plate's unit normal vector."""
    return _context().dskn02(handle, dladsc, plid)

def dskobj(dsk, bodids=None):
    """Find the set of body ID codes of all objects for which topographic data are provided in a specified DSK file.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dskobj.html
    
    :param dsk: Name of DSK file.
    :param bodids: Set of ID codes of objects in DSK
    :return: Set of ID codes of objects in DSK"""
    return _context().dskobj(dsk, bodids)

def dskopn(fname, ifname, ncomch):
    """Open a new DSK file for subsequent write operations.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dskopn.html
    
    :param fname: Name of a DSK file to be opened.
    :param ifname: Internal file name.
    :param ncomch: Number of comment characters to allocate.
    :return: Handle assigned to the opened DSK file."""
    return _context().dskopn(fname, ifname, ncomch)

def dskp02(handle, dladsc, start, room):
    """Fetch triangular plates from a type 2 DSK segment.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dskp02.html
    
    :param handle: DSK file handle.
    :param dladsc: DLA descriptor.
    :param start: Start index.
    :param room: Amount of room in output array.
    :return: Number of plates returned.; Array containing plates."""
    return _context().dskp02(handle, dladsc, start, room)

def dskrb2(vrtces, plates, corsys, corpar):
    """Determine range bounds for a set of triangular plates to be stored in a type 2 DSK segment.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dskrb2.html
    
    :param vrtces: Vertices.
    :param plates: Plates.
    :param corsys: DSK coordinate system code.
    :param corpar: DSK coordinate system parameters.
    :return: Lower bound on range of third coordinate.; Upper bound on range of third coordinate."""
    return _context().dskrb2(vrtces, plates, corsys, corpar)

def dsksrf(dsk, bodyid, srfids=None):
    """Find the set of surface ID codes for all surfaces associated with a given body in a specified DSK file.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dsksrf.html
    
    :param dsk: Name of DSK file.
    :param bodyid: Integer body ID code.
    :param srfids: Set of ID codes of surfaces in DSK
    :return: Set of ID codes of surfaces in DSK"""
    return _context().dsksrf(dsk, bodyid, srfids)

def dskstl(keywrd, dpval):
    """Set the value of a specified DSK tolerance or margin parameter.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dskstl.html
    
    :param keywrd: Code specifying parameter to modify.
    :param dpval: New value of parameter."""
    return _context().dskstl(keywrd, dpval)

def dskv02(handle, dladsc, start, room):
    """Fetch vertices from a type 2 DSK segment.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dskv02.html
    
    :param handle: DSK file handle.
    :param dladsc: DLA descriptor.
    :param start: Start index.
    :param room: Amount of room in output array.
    :return: Number of vertices returned.; Array containing vertices."""
    return _context().dskv02(handle, dladsc, start, room)

def dskw02(handle, center, surfid, dclass, fname, corsys, corpar, mncor1, mxcor1, mncor2, mxcor2, mncor3, mxcor3, first, last, vrtces, plates, spaixd, spaixi):
    """Write a type 2 segment to a DSK file.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dskw02.html
    
    :param handle: Handle assigned to the opened DSK file.
    :param center: Central body ID code.
    :param surfid: Surface ID code.
    :param dclass: Data class.
    :param fname: Reference frame.
    :param corsys: Coordinate system code.
    :param corpar: Coordinate system parameters.
    :param mncor1: Minimum value of first coordinate.
    :param mxcor1: Maximum value of first coordinate.
    :param mncor2: Minimum value of second coordinate.
    :param mxcor2: Maximum value of second coordinate.
    :param mncor3: Minimum value of third coordinate.
    :param mxcor3: Maximum value of third coordinate.
    :param first: Coverage start time.
    :param last: Coverage stop time.
    :param vrtces: Vertices.
    :param plates: Plates.
    :param spaixd: Double precision component of spatial index.
    :param spaixi: Integer component of spatial index."""
    return _context().dskw02(handle, center, surfid, dclass, fname, corsys, corpar, mncor1, mxcor1, mncor2, mxcor2, mncor3, mxcor3, first, last, vrtces, plates, spaixd, spaixi)

def dskx02(handle, dladsc, vertex, raydir):
    """Determine the plate ID and body-fixed coordinates of the intersection of a specified ray with the surface defined by a type 2 DSK plate model.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dskx02.html
    
    :param handle: Handle of DSK kernel containing plate model.
    :param dladsc: DLA descriptor of plate model segment.
    :param vertex: Ray's vertex in the  body fixed frame.
    :param raydir: Ray direction in the body fixed frame.
    :return: ID code of the plate intersected by the ray.; Intercept.; Flag indicating whether intercept exists."""
    return _context().dskx02(handle, dladsc, vertex, raydir)

def dskxsi(pri, target, srflst, et, fixref, vertex, raydir):
    """Compute a ray-surface intercept using data provided by multiple loaded DSK segments. Return information about the source of the data defining the surface on which the intercept was found: DSK handle, DLA and DSK descriptors, and DSK data type-dependent parameters.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dskxsi.html
    
    :param pri: Data prioritization flag.
    :param target: Target body name.
    :param srflst: Surface ID list.
    :param et: Epoch, expressed as seconds past J2000 TDB.
    :param fixref: Name of target body-fixed reference frame.
    :param vertex: Vertex of ray.
    :param raydir: Direction vector of ray.
    :return: Intercept point.; Handle of segment contributing surface data.; DLA descriptor of segment.; DSK descriptor of segment.; Double precision component of source info.; Integer component of source info.
        (found: NotFoundError if not found, or the flag returned last with no_found_check)"""
    return _context().dskxsi(pri, target, srflst, et, fixref, vertex, raydir)

def dskxv(pri, target, srflst, et, fixref, vtxarr, dirarr):
    """Compute ray-surface intercepts for a set of rays, using data provided by multiple loaded DSK segments.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dskxv.html
    
    :param pri: Data prioritization flag.
    :param target: Target body name.
    :param srflst: Surface ID list.
    :param et: Epoch, expressed as seconds past J2000 TDB.
    :param fixref: Name of target body-fixed reference frame.
    :param vtxarr: Array of vertices of rays.
    :param dirarr: Array of direction vectors of rays.
    :return: Intercept point array.; Found flag array."""
    return _context().dskxv(pri, target, srflst, et, fixref, vtxarr, dirarr)

def dskz02(handle, dladsc):
    """Return plate model size parameters---plate count and vertex count---for a type 2 DSK segment.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dskz02.html
    
    :param handle: DSK file handle.
    :param dladsc: DLA descriptor.
    :return: Number of vertices.; Number of plates."""
    return _context().dskz02(handle, dladsc)

def dsphdr(x, y, z):
    """Compute the Jacobian matrix of the transformation from rectangular to spherical coordinates.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dsphdr.html
    
    :param x: X-coordinate of point.
    :param y: Y-coordinate of point.
    :param z: Z-coordinate of point.
    :return: Matrix of partial derivatives."""
    return _context().dsphdr(x, y, z)

def dtpool(name):
    """Return the data about a kernel pool variable.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dtpool.html
    
    :param name: Name of the variable whose value is to be returned.
    :return: Number of values returned for NAME.; Type of the variable 'C', 'N', 'X'
        (found: NotFoundError if not found, or the flag returned last with no_found_check)"""
    return _context().dtpool(name)

def dvsep(s1, s2):
    """Calculate the time derivative of the separation angle between two input states, S1 and S2.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dvsep.html
    
    :param s1: State vector of the first body.
    :param s2: State vector of the second body.
    :return: the result"""
    return _context().dvsep(s1, s2)

def dwpool(agent):
    """Delete a name from the list of agents to notify whenever a member of a list of kernel variables is updated.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/dwpool.html
    
    :param agent: The name of an agent to be notified after updates."""
    return _context().dwpool(agent)

def edlimb(a, b, c, viewpt):
    """Find the limb of a triaxial ellipsoid, viewed from a specified point.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/edlimb.html
    
    :param a: Length of ellipsoid semi-axis lying on the x-axis.
    :param b: Length of ellipsoid semi-axis lying on the y-axis.
    :param c: Length of ellipsoid semi-axis lying on the z-axis.
    :param viewpt: Location of viewing point.
    :return: Limb of ellipsoid as seen from viewing point."""
    return _context().edlimb(a, b, c, viewpt)

def ednmpt(a, b, c, normal):
    """Return the unique point on an ellipsoid's surface where the outward normal direction is a given vector.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/ednmpt.html
    
    :param a: Length of the ellipsoid semi-axis along the X-axis.
    :param b: Length of the ellipsoid semi-axis along the Y-axis.
    :param c: Length of the ellipsoid semi-axis along the Z-axis.
    :param normal: Outward normal direction.
    :return: Point where outward normal is parallel to NORMAL."""
    return _context().ednmpt(a, b, c, normal)

def edpnt(p, a, b, c):
    """Scale a point so that it lies on the surface of a specified triaxial ellipsoid that is centered at the origin and aligned with the Cartesian coordinate axes.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/edpnt.html
    
    :param p: A point in three-dimensional space.
    :param a: Semi-axis length in the X direction.
    :param b: Semi-axis length in the Y direction.
    :param c: Semi-axis length in the Z direction.
    :return: Point on ellipsoid."""
    return _context().edpnt(p, a, b, c)

def edterm(trmtyp, source, target, et, fixref, abcorr, obsrvr, npts):
    """Compute a set of points on the umbral or penumbral terminator of a specified target body, where the target shape is modeled as an ellipsoid.
    
    https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/edterm.html
    
    :param trmtyp: Terminator type.
    :param source: Light source.
    :param target: Target body.
    :param et: Observation epoch.
    :param fixref: Body-fixed frame associated with target.
    :param abcorr: Aberration correction.
    :param obsrvr: Observer.
    :param npts: Number of points in terminator set.
    :return: Epoch associated with target center.; Position of observer in body-fixed frame.; Terminator point set."""
    return _context().edterm(trmtyp, source, target, et, fixref, abcorr, obsrvr, npts)

def ek_values_int(handle, segno, recno, column):
    """All the values of an integer column entry of an EK record (PEPPER; `ekrcei` with the size of the entry). Bound as the generic `ek_values`.
    
    :param handle: the handle of the EK file
    :param segno: the segment number
    :param recno: the record number
    :param column: the column name
    :return: the values (size 0 if null, or after an error); the entry is null"""
    return _context().ek_values_int(handle, segno, recno, column)

def ek_values_real(handle, segno, recno, column):
    """All the values of a double precision or time column entry of an EK record (PEPPER; `ekrced` with the size of the entry). Bound as the generic `ek_values`.
    
    :param handle: the handle of the EK file
    :param segno: the segment number
    :param recno: the record number
    :param column: the column name
    :return: the values (size 0 if null, or after an error); the entry is null"""
    return _context().ek_values_real(handle, segno, recno, column)

def ek_values_str(handle, segno, recno, column):
    """All the values of a character column entry of an EK record, each of its full length (PEPPER; `ekrcec` with the size of the entry). Bound as the generic `ek_values`. Values of fixed-length columns are returned without their trailing blanks.
    
    :param handle: the handle of the EK file
    :param segno: the segment number
    :param recno: the record number
    :param column: the column name
    :return: the values (size 0 if null, or after an error); the entry is null"""
    return _context().ek_values_str(handle, segno, recno, column)

def ekacec(handle, segno, recno, column, nvals, cvals, isnull):
