        cdef double _c_t = t
        cdef int _st = 0
        cdef cnp.ndarray _a_state = _empty(NPY_DOUBLE, 6, -1)
        self._enter()
        try:
            _st = pepper_xxsgp4e(self._ptr, _c_t, <double*>cnp.PyArray_DATA(_a_state))
            if _st:
                self._raise()
        finally:
            self._leave()
        return _a_state

