    def xf2eul(self, xform, axisa, axisb, axisc):
        """Convert a state transformation matrix to Euler angles and their derivatives, given a specified set of axes.
        
        https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/xf2eul.html
        
        :param xform: A state transformation matrix.
        :param axisa: Axis A of the Euler angle factorization.
        :param axisb: Axis B of the Euler angle factorization.
        :param axisc: Axis C of the Euler angle factorization.
        :return: An array of Euler angles and their derivatives.; Indicates if EULANG is a unique representation."""
        cdef int _c_axisa = axisa
        cdef int _c_axisb = axisb
        cdef int _c_axisc = axisc
        cdef int _c_unique = 0
        cdef int _st = 0
        cdef cnp.ndarray _a_xform = _input(xform, NPY_DOUBLE, 6, 6, False)
        cdef cnp.ndarray _a_eulang = _empty(NPY_DOUBLE, 6, -1)
        self._enter()
        try:
            _st = pepper_xf2eul(self._ptr, <double*>cnp.PyArray_DATA(_a_xform), _c_axisa, _c_axisb, _c_axisc, <double*>cnp.PyArray_DATA(_a_eulang), &_c_unique)
            if _st:
                self._raise()
        finally:
            self._leave()
        return _a_eulang, (_c_unique != 0)

    def xf2eul_v(self, xform, axisa, axisb, axisc):
        """`xf2eul` at each element of `xform` (arrays), in a C loop with the GIL released (PepperyPy's; SpiceyPy's cyice has none).
        
        The other arguments are those of `xf2eul`. The results are arrays whose first dimension is the number of elements."""
        cdef int _c_axisa = axisa
        cdef int _c_axisb = axisb
        cdef int _c_axisc = axisc
        cdef Py_ssize_t _i
        cdef int _st = 0
        cdef cnp.ndarray _v_xform = np.asarray(xform, dtype=np.float64)
        if _v_xform.ndim == 2: _v_xform = _v_xform.reshape(1, _v_xform.shape[0], _v_xform.shape[1])
        if _v_xform.ndim != 3 or _v_xform.shape[1] != 6 or _v_xform.shape[2] != 6: raise ValueError("xform: expected 6x6 matrices")
        _v_xform = np.ascontiguousarray(_v_xform.transpose(0, 2, 1))
        cdef const double *_pv_xform = <const double*>cnp.PyArray_DATA(_v_xform)
        cdef Py_ssize_t _s_xform = 0 if _v_xform.shape[0] == 1 else 36
        cdef Py_ssize_t _n = _vlen([_v_xform.shape[0]])
        cdef cnp.ndarray _o_eulang = np.empty((max(_n, 1), 6), dtype=np.float64)
        cdef double *_q_eulang = <double*>cnp.PyArray_DATA(_o_eulang)
        cdef cnp.ndarray _o_unique = np.empty(max(_n, 1), dtype=np.int32)
        cdef int *_q_unique = <int*>cnp.PyArray_DATA(_o_unique)
        self._enter()
        try:
            with nogil:
                for _i in range(_n):
                    _st = pepper_xf2eul(self._ptr, _pv_xform + _i * _s_xform, _c_axisa, _c_axisb, _c_axisc, _q_eulang + _i * 6, _q_unique + _i)
                    if _st:
                        break
            if _st:
                self._raise()
        finally:
            self._leave()
        return _o_eulang[:_n], (_o_unique[:_n] != 0)

    def xfmsta(self, input_state, input_coord_sys, output_coord_sys, body):
        """Transform a state between coordinate systems.
        
        https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/FORTRAN/spicelib/xfmsta.html
        
        :param input_state: Input state.
        :param input_coord_sys: Current (input) coordinate system.
        :param output_coord_sys: Desired (output) coordinate system.
        :param body: Name or NAIF ID of body with which coordinates are associated (if applicable).
        :return: Converted output state."""
        if not input_coord_sys: _empty_string('xfmsta', 'icosys')
        if not output_coord_sys: _empty_string('xfmsta', 'ocosys')
        if not body: _empty_string('xfmsta', 'body')
        cdef int _st = 0
        cdef bytes _b_icosys = _b(input_coord_sys)
        cdef bytes _b_ocosys = _b(output_coord_sys)
        cdef bytes _b_body = _b(body)
        cdef const char *_c_icosys = _b_icosys
        cdef const char *_c_ocosys = _b_ocosys
        cdef const char *_c_body = _b_body
        cdef cnp.ndarray _a_istate = _input(input_state, NPY_DOUBLE, 6, -1, False)
        cdef cnp.ndarray _a_ostate = _empty(NPY_DOUBLE, 6, -1)
        self._enter()
        try:
            _st = pepper_xfmsta(self._ptr, <double*>cnp.PyArray_DATA(_a_istate), _c_icosys, _c_ocosys, _c_body, <double*>cnp.PyArray_DATA(_a_ostate))
            if _st:
                self._raise()
        finally:
            self._leave()
        return _a_ostate

    def xfmsta_v(self, input_state, input_coord_sys, output_coord_sys, body):
        """`xfmsta` at each element of `input_state` (arrays), in a C loop with the GIL released (SpiceyPy's cyice `xfmsta_v`).
        
        The other arguments are those of `xfmsta`. The results are arrays whose first dimension is the number of elements."""
        if not input_coord_sys: _empty_string('xfmsta', 'icosys')
        if not output_coord_sys: _empty_string('xfmsta', 'ocosys')
        if not body: _empty_string('xfmsta', 'body')
        cdef Py_ssize_t _i
        cdef int _st = 0
        cdef cnp.ndarray _v_istate = np.ascontiguousarray(input_state, dtype=np.float64)
        if _v_istate.ndim == 1: _v_istate = _v_istate.reshape(1, -1)
        if _v_istate.ndim != 2 or _v_istate.shape[1] != 6: raise ValueError("input_state: expected vectors of 6 values")
        cdef const double *_pv_istate = <const double*>cnp.PyArray_DATA(_v_istate)
        cdef Py_ssize_t _s_istate = 0 if _v_istate.shape[0] == 1 else 6
        cdef bytes _b_icosys = _b(input_coord_sys)
        cdef const char *_c_icosys = _b_icosys
        cdef bytes _b_ocosys = _b(output_coord_sys)
        cdef const char *_c_ocosys = _b_ocosys
        cdef bytes _b_body = _b(body)
        cdef const char *_c_body = _b_body
        cdef Py_ssize_t _n = _vlen([_v_istate.shape[0]])
        cdef cnp.ndarray _o_ostate = np.empty((max(_n, 1), 6), dtype=np.float64)
        cdef double *_q_ostate = <double*>cnp.PyArray_DATA(_o_ostate)
        self._enter()
        try:
            with nogil:
                for _i in range(_n):
                    _st = pepper_xfmsta(self._ptr, _pv_istate + _i * _s_istate, _c_icosys, _c_ocosys, _c_body, _q_ostate + _i * 6)
                    if _st:
                        break
            if _st:
                self._raise()
        finally:
